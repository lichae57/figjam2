@using System.Security.Claims
@{
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString()?.ToLower() ?? "";
    var isHomePage = currentPath == "/" || currentPath == "/index" || currentPage == "/index" || currentPage == "/";
    
    // Kullanıcı adını önce Custom "FullName" Claim'den, sonra ClaimTypes.Name'den, sonra Session'dan al
    string? userName = null;
    
    if (User.Identity?.IsAuthenticated == true)
    {
        // Önce custom FullName claim'i dene
        userName = User.FindFirst("FullName")?.Value;
        
        // Yoksa standart Name claim'i dene
        if (string.IsNullOrEmpty(userName))
        {
            userName = User.FindFirst(ClaimTypes.Name)?.Value;
        }
    }
    
    // Claim'de yoksa Session'dan al
    if (string.IsNullOrEmpty(userName))
    {
        userName = ViewContext.HttpContext.Session.GetString("UserName");
    }
    
    // Hala boşsa varsayılan değer kullanma - boş bırak
    if (string.IsNullOrEmpty(userName))
    {
        userName = "Kullanıcı"; // Varsayılan - API'den veri gelene kadar
    }
    
    // Identifier'ı önce Claim'den, sonra Session'dan al
    string? identifier = null;
    
    if (User.Identity?.IsAuthenticated == true)
    {
        identifier = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }
    
    if (string.IsNullOrEmpty(identifier))
    {
        identifier = ViewContext.HttpContext.Session.GetString("Identifier");
    }
    
    if (string.IsNullOrEmpty(identifier))
    {
        identifier = ViewContext.HttpContext.Session.GetString("Tckn");
    }
    
    // TC Kimlik numarasını maskele
    if (!string.IsNullOrEmpty(identifier) && identifier.Length == 11 && identifier.All(char.IsDigit))
    {
        identifier = identifier.Substring(0, 2) + "*****" + identifier.Substring(9);
    }
    
    if (string.IsNullOrEmpty(identifier))
    {
        identifier = "***";
    }
}

@if ((ViewData["ShowNavbar"] as bool?) ?? true)
{
    <header class="bank-header">
        <nav class="navbar navbar-light bg-white shadow-sm">
            <div class="container d-flex justify-content-between align-items-center">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="@(User.Identity?.IsAuthenticated == true ? "/Dashboard" : "/Index")" style="margin-right: 0; padding-left: 0; background: white; padding: 0.5rem 1rem; border-radius: 8px; text-decoration: none;">
                    <img src="~/img/logo.png" alt="Interaktif Kredi" style="height: 55px; width: auto;" />
                </a>
                
                <div class="d-flex align-items-center gap-3 ms-auto">
                    @if (isHomePage)
                    {
                        <!-- Ana Sayfa: Sadece Giriş Yap Butonu -->
                        <a href="/Login" class="btn" style="background-color: #E6F7FF; color: #2E6DF8; border: 1px solid #2E6DF8; border-radius: 12px; padding: 0.5rem 1.5rem; font-weight: 600; text-decoration: none; transition: all 0.3s ease; display: flex; align-items: center; gap: 0.5rem;">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>Giriş Yap</span>
                        </a>
                    }
                    else
                    {
                        <!-- Diğer Sayfalar: Kredi Raporları, Yardım ve Destek Merkezi, Profil -->
                        <!-- API bağlı olmadığı için her zaman gösteriliyor -->
                        <a href="/CreditReport" class="btn" style="background-color: #E6F7FF; color: #2E6DF8; border: 1px solid #2E6DF8; border-radius: 12px; padding: 0.5rem 1.5rem; font-weight: 600; text-decoration: none; transition: all 0.3s ease; display: flex; align-items: center; gap: 0.5rem;">
                            <i class="fas fa-file-alt"></i>
                            <span>Kredi Raporları</span>
                        </a>
                        <a href="/CustomerService" class="btn" style="background-color: #E6F7FF; color: #2E6DF8; border: 1px solid #2E6DF8; border-radius: 12px; padding: 0.5rem 1.5rem; font-weight: 600; text-decoration: none; transition: all 0.3s ease; display: flex; align-items: center; gap: 0.5rem;">
                            <i class="fas fa-headset"></i>
                            <span>Yardım ve Destek Merkezi</span>
                        </a>
                        <!-- Profil Dropdown -->
                        <div class="dropdown">
                            <button class="btn dropdown-toggle" 
                                    type="button" 
                                    id="profileDropdown" 
                                    data-bs-toggle="dropdown" 
                                    aria-expanded="false"
                                    style="background-color: #E6F7FF; color: #2E6DF8; border: 1px solid #2E6DF8; border-radius: 12px; padding: 0.5rem 1.5rem; font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
                                <i class="fas fa-user"></i>
                                <span>Profil</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown" style="margin-top: 0.5rem; border: 1px solid #E6F7FF; box-shadow: 0 8px 24px rgba(46, 109, 248, 0.15); border-radius: 12px; padding: 1rem 0; min-width: 280px;">
                                <!-- Kullanıcı Özeti -->
                                <li>
                                    <div class="px-3 py-3 border-bottom" style="border-color: #E6F7FF !important;">
                                        <div class="d-flex align-items-center gap-3">
                                            <div style="width: 50px; height: 50px; border-radius: 50%; background: linear-gradient(135deg, #2E6DF8 0%, #0056B3 100%); display: flex; align-items: center; justify-content: center; overflow: hidden; border: 2px solid #E6F7FF; flex-shrink: 0;">
                                                <i class="fas fa-user" style="color: white; font-size: 1.4rem;"></i>
                                            </div>
                                            <div style="flex: 1; min-width: 0;">
                                                <div class="fw-bold" style="color: #2E6DF8; font-size: 0.95rem; margin-bottom: 0.25rem;">@userName</div>
                                                <div class="text-muted" style="font-size: 0.8rem; word-break: break-word;">@identifier</div>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider my-2" style="margin: 0.5rem 0; border-color: #E6F7FF;"></li>
                                <li>
                                    <a class="dropdown-item py-2 px-3" href="/Profile" style="transition: all 0.2s ease; display: flex; align-items: center; gap: 0.5rem; color: #333;">
                                        <i class="fas fa-user"></i>
                                        <span>Profil Detayları</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 px-3" href="/Settings" style="transition: all 0.2s ease; display: flex; align-items: center; gap: 0.5rem; color: #333;">
                                        <i class="fas fa-cog"></i>
                                        <span>Ayarlar</span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-2" style="margin: 0.5rem 0; border-color: #E6F7FF;"></li>
                                <!-- Güvenli Çıkış -->
                                <li>
                                    <a class="dropdown-item py-2 px-3 text-danger fw-semibold" href="#" onclick="logout(); return false;" style="transition: all 0.2s ease; display: flex; align-items: center; gap: 0.5rem;">
                                        <i class="fas fa-sign-out-alt"></i>
                                        <span>Oturumu Kapat</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
}

