            }
        }

        /* Ayarlar İkonu Stilleri */
        .btn-link:hover i.fa-cog {
            transform: rotate(90deg);
            color: #0056B3 !important;
        }

        .btn-link i.fa-cog {
            transition: transform 0.3s ease, color 0.3s ease;
        }

        /* Header Navigation Linkleri */
        .nav-link-custom:hover {
            background-color: #E6F7FF !important;
            color: #0056B3 !important;
        }

        .nav-link-custom i {
            font-size: 0.9rem;
        }

        /* Profil Dropdown Stilleri */
        .dropdown-toggle::after {
            margin-left: 0.5rem;
            color: #2E6DF8;
        }

        .dropdown-menu {
            border: 1px solid #E6F7FF !important;
        }

        .dropdown-item:hover {
            background-color: #E6F7FF !important;
            color: #2E6DF8 !important;
        }

        .dropdown-item.text-danger:hover {
            background-color: #FFF5F5 !important;
            color: #DC3545 !important;
        }

        /* Giriş Yapmamış Kullanıcılar İçin Butonlar */
        .btn-outline-primary-custom {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background-color: transparent;
            transition: all 0.3s ease;
        }

        .btn-outline-primary-custom:hover {
            color: var(--text-light);
            background-color: var(--primary-color);
            box-shadow: 0 4px 8px rgba(34, 40, 84, 0.2);
            transform: translateY(-2px);
        }

        /* Dashboard Header Butonları */
        .dropdown-toggle.btn:hover {
            background-color: #2E6DF8 !important;
            color: white !important;
            border-color: #2E6DF8 !important;
        }

        .btn[href="/CreditReport"]:hover,
        .btn[href="/CustomerService"]:hover {
            background-color: #2E6DF8 !important;
            color: white !important;
            border-color: #2E6DF8 !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(46, 109, 248, 0.3);
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .nav-link-custom span {
                display: none;
            }

            .nav-link-custom {
                padding: 0.5rem !important;
            }
        }

        @@media (max-width: 768px) {
            .search-container input {
                width: 150px !important;
            }

            .notification-icon-container,
            .btn-link {
                padding: 0.25rem !important;
            }

            .dropdown-toggle span {
                display: none !important;
            }

            .nav-link-custom {
                display: none !important;
            }
        }
    </style>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Oturum Zaman Aşımı Mekanizması
        (function() {
            // Session'dan timeout değerini al (dakika cinsinden)
            @{
                var sessionTimeout = ViewContext.HttpContext.Session.GetString("SessionTimeoutMinutes");
                var timeoutValue = string.IsNullOrEmpty(sessionTimeout) ? "15" : sessionTimeout;
            }
            var timeoutMinutes = parseInt('@timeoutValue');
            var timeoutMilliseconds = timeoutMinutes * 60 * 1000; // Dakikayı milisaniyeye çevir
            
            var timeoutId;
            var warningShown = false;
            
            // Timeout'u sıfırla
            function resetTimeout() {
                clearTimeout(timeoutId);
                warningShown = false;
                
                timeoutId = setTimeout(function() {
                    // Timeout süresi doldu, oturumu kapat ve Index sayfasına yönlendir
                    performLogout();
                }, timeoutMilliseconds);
            }
            
            // Kullanıcı aktivitelerini dinle
            var events = ['mousedown', 'mousemove', 'keypress', 'scroll', 'touchstart', 'click'];
            events.forEach(function(event) {
                document.addEventListener(event, resetTimeout, true);
            });
            
            // İlk timeout'u başlat
            resetTimeout();
            
            // Logout fonksiyonu
            function performLogout() {
                // Önce mevcut logout fonksiyonunu kontrol et
                if (typeof window.logout === 'function') {
                    window.logout();
                } else {
                    // Logout sayfasına GET isteği gönder (Logout.cshtml.cs OnGet kullanıyor)
                    fetch('/Logout', {
                        method: 'GET',
                        credentials: 'include'
                    })
                    .then(function() {
                        window.location.replace('/Index');
                    })
                    .catch(function() {
                        window.location.replace('/Index');
                    });
                }
            }
        })();
    </script>
