    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Dropdown hover functionality
        document.addEventListener('DOMContentLoaded', function() {
            const dropdowns = document.querySelectorAll('.navbar-nav .dropdown');
            
            dropdowns.forEach(dropdown => {
                const dropdownToggle = dropdown.querySelector('.dropdown-toggle');
                const dropdownMenu = dropdown.querySelector('.dropdown-menu');
                
                // Hover aç
                dropdown.addEventListener('mouseenter', function() {
                    const bsDropdown = new bootstrap.Dropdown(dropdownToggle);
                    bsDropdown.show();
                });
                
                // Hover kapat (menü dışına çıkınca)
                dropdown.addEventListener('mouseleave', function() {
                    const bsDropdown = bootstrap.Dropdown.getInstance(dropdownToggle);
                    if (bsDropdown) {
                        bsDropdown.hide();
                    }
                });
            });
        });

        // Sayfa yüklendiğinde overlay temizleme
        (function() {
            function cleanupOverlay() {
                // Tüm backdrop ve overlay'leri kaldır
                const backdrops = document.querySelectorAll('.modal-backdrop, .offcanvas-backdrop, [class*="backdrop"], [class*="overlay"]');
                backdrops.forEach(backdrop => {
                    backdrop.remove();
                    backdrop.style.display = 'none';
                    backdrop.style.visibility = 'hidden';
                    backdrop.style.pointerEvents = 'none';
                });
                
                // Body'den modal-open class'ını kaldır
                document.body.classList.remove('modal-open');
                
                // Body'nin overflow ve padding stillerini sıfırla
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';
                document.body.style.position = '';
                document.body.style.pointerEvents = '';
                
                // Tüm fixed position overlay'leri bul ve kaldır
                const allElements = document.querySelectorAll('*');
                allElements.forEach(el => {
                    const computedStyle = window.getComputedStyle(el);
                    if (computedStyle.position === 'fixed' && 
                        (computedStyle.backgroundColor === 'rgba(0, 0, 0, 0.5)' || 
                         computedStyle.backgroundColor === 'rgb(0, 0, 0)' ||
                         el.classList.contains('backdrop') ||
                         el.classList.contains('overlay'))) {
                        el.style.display = 'none';
                        el.style.pointerEvents = 'none';
                        el.style.visibility = 'hidden';
                    }
                });
            }
            
            // Sayfa yüklendiğinde
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', cleanupOverlay);
            } else {
                cleanupOverlay();
            }
            
            // Window load olduğunda da temizle
            window.addEventListener('load', cleanupOverlay);
            
            // Her 1 saniyede bir kontrol et
            setInterval(cleanupOverlay, 1000);
        })();

        // Logout fonksiyonu
        function logout() {
            // Direkt olarak Logout sayfasına git (GET request)
            // Logout sayfası session'ı temizleyip ana sayfaya yönlendirecek
            window.location.href = '/Logout';
        }
    </script>

    <style>
        /* Header Stilleri */
        .bank-header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: white;
        }

        .bank-header .navbar {
            padding: 0.75rem 0;
            min-height: 70px;
        }

        /* Arama Çubuğu Stilleri */
        .search-container input::placeholder {
            color: #6c757d !important;
        }
        
        .search-container input:focus {
            background-color: #ffffff !important;
            border-color: #2E6DF8 !important;
            outline: none;
            box-shadow: 0 0 0 3px rgba(46, 109, 248, 0.1) !important;
        }
        
        .search-container input:focus::placeholder {
            color: #6c757d !important;
        }

        .search-container input:hover {
            border-color: #2E6DF8 !important;
        }

        /* Bildirim İkonu Stilleri */
        .notification-icon-container:hover i {
            color: #0056B3 !important;
            transform: scale(1.1);
        }

        .notification-badge {
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.7;
            }
        }

        /* Ayarlar İkonu Stilleri */
        .btn-link:hover i.fa-cog {
            transform: rotate(90deg);
            color: #0056B3 !important;
        }

        .btn-link i.fa-cog {
            transition: transform 0.3s ease, color 0.3s ease;
        }

        /* Profil Dropdown Stilleri */
        .dropdown-toggle::after {
            margin-left: 0.5rem;
            color: #2E6DF8;
        }

        .dropdown-menu {
            border: 1px solid #E6F7FF !important;
        }

        .dropdown-item:hover {
            background-color: #E6F7FF !important;
            color: #2E6DF8 !important;
        }

        .dropdown-item.text-danger:hover {
            background-color: #FFF5F5 !important;
            color: #DC3545 !important;
        }

        /* Giriş Yapmamış Kullanıcılar İçin Butonlar */
        .btn-outline-primary-custom {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background-color: transparent;
            transition: all 0.3s ease;
        }

        .btn-outline-primary-custom:hover {
            color: var(--text-light);
            background-color: var(--primary-color);
            box-shadow: 0 4px 8px rgba(34, 40, 84, 0.2);
            transform: translateY(-2px);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .search-container input {
                width: 150px !important;
            }

            .notification-icon-container,
            .btn-link {
                padding: 0.25rem !important;
            }

            .dropdown-toggle span {
                display: none !important;
            }
        }
    </style>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>