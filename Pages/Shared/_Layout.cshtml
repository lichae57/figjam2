<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - İnteraktif Şube</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/figjam2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    @if (ViewData["ShowNavbar"] == null || (bool)ViewData["ShowNavbar"] == true)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-page="/Dashboard">
                        <i class="fas fa-university me-2"></i>
                        İnteraktif Şube
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Dashboard">
                                    <i class="fas fa-home me-1"></i>Ana Sayfa
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Services">
                                    <i class="fas fa-concierge-bell me-1"></i>Hizmetler
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/CreditCalculator">
                                    <i class="fas fa-calculator me-1"></i>Kredi Hesaplama
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Reports">
                                    <i class="fas fa-file-invoice me-1"></i>Raporlar & Faturalar
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Profile">
                                    <i class="fas fa-user me-1"></i>Profil
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/FAQ">
                                    <i class="fas fa-question-circle me-1"></i>SSS
                                </a>
                            </li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Login">
                                    <i class="fas fa-sign-out-alt me-1"></i>Çıkış
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main role="main" class="@(ViewData["ShowNavbar"] == null || (bool)ViewData["ShowNavbar"] == true ? "" : "full-height")">
        @RenderBody()
    </main>

    @if (ViewData["ShowFooter"] == null || (bool)ViewData["ShowFooter"] == true)
    {
        <footer class="mt-5 py-4" style="background-color: var(--primary-color); color: var(--text-light);">
            <div class="container">
                <div class="row">
                    <div class="col-md-6">
                        <h5>İnteraktif Şube</h5>
                        <p class="mb-0">Dijital bankacılık deneyiminiz için yanınızdayız.</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <p class="mb-0">
                            <i class="fas fa-shield-alt me-2"></i>
                            Güvenli ve Şifrelenmiş Bağlantı
                        </p>
                        <p class="mb-0 mt-2">
                            &copy; 2025 - Tüm hakları saklıdır.
                        </p>
                    </div>
                </div>
            </div>
        </footer>
    }

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>