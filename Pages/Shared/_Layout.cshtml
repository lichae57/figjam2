<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - İnteraktif Şube</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/figjam2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    @if ((ViewData["ShowNavbar"] as bool?) ?? true)
    {
        <header class="bank-header">
            <nav class="navbar navbar-light bg-white shadow-sm">
                <div class="container d-flex justify-content-between align-items-center">
                    <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="@(ViewContext.HttpContext.Session.GetString("IsLoggedIn") == "true" ? "/Dashboard" : "/Index")" style="margin-right: 0; padding-left: 0; background: white; padding: 0.5rem 1rem; border-radius: 8px; text-decoration: none;">
                        <img src="~/img/logo.png" alt="Interaktif Kredi" style="height: 55px; width: auto;" />
                    </a>
                    
                    @if (ViewContext.HttpContext.Session.GetString("IsLoggedIn") == "true")
                    {
                        <div class="d-flex align-items-center gap-3">
                            <!-- Arama Çubuğu -->
                            <div class="search-container" style="position: relative;">
                                <i class="fas fa-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: #2E6DF8; font-size: 0.9rem; pointer-events: none; z-index: 1;"></i>
                                <input type="text" 
                                       class="form-control" 
                                       placeholder="Ara..." 
                                       style="width: 250px; padding-left: 2.5rem; padding-right: 0.75rem; padding-top: 0.5rem; padding-bottom: 0.5rem; background-color: #F5F7FA; border: 1px solid #E6F7FF; border-radius: 12px; color: #333; font-size: 0.9rem; height: auto; transition: all 0.3s ease;">
                            </div>

                            <!-- Bildirim İkonu -->
                            <div class="notification-icon-container" style="position: relative; cursor: pointer;">
