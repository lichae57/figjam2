                                <span class="notification-badge" style="position: absolute; top: 0.25rem; right: 0.25rem; width: 8px; height: 8px; background-color: #DC3545; border-radius: 50%; border: 2px solid white; display: block;"></span>
                            </div>

                            <!-- Ayarlar İkonu -->
                            <a href="/Settings" class="btn btn-link text-decoration-none d-flex align-items-center" style="border: none; padding: 0.5rem; color: #2E6DF8; transition: all 0.3s ease;">
                                <i class="fas fa-cog" style="font-size: 1.3rem; color: #2E6DF8;"></i>
                            </a>

                            <!-- Profil Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-link text-decoration-none d-flex align-items-center dropdown-toggle" 
                                        type="button" 
                                        id="profileDropdown" 
                                        data-bs-toggle="dropdown" 
                                        aria-expanded="false"
                                        style="border: none; padding: 0.25rem 0.5rem; color: #2E6DF8; gap: 0.75rem;">
                                    <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #2E6DF8 0%, #0056B3 100%); display: flex; align-items: center; justify-content: center; overflow: hidden; border: 2px solid #E6F7FF;">
                                        <img src="~/img/profile-placeholder.png" alt="Profil" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                        <i class="fas fa-user" style="display: none; color: white; font-size: 1rem;"></i>
                                    </div>
                                    <span class="d-none d-md-inline fw-semibold" style="color: #2E6DF8; font-size: 0.95rem;">@(ViewContext.HttpContext.Session.GetString("UserName") ?? "Ahmet Yılmaz")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown" style="margin-top: 0.5rem; border: none; box-shadow: 0 8px 24px rgba(46, 109, 248, 0.15); border-radius: 12px; padding: 0.75rem 0; min-width: 220px;">
                                    <li>
                                        <div class="px-3 py-2 border-bottom" style="border-color: #E6F7FF !important;">
                                            <div class="d-flex align-items-center gap-2">
                                                <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #2E6DF8 0%, #0056B3 100%); display: flex; align-items: center; justify-content: center; overflow: hidden; border: 2px solid #E6F7FF;">
                                                    <img src="~/img/profile-placeholder.png" alt="Profil" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                    <i class="fas fa-user" style="display: none; color: white; font-size: 1rem;"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold small" style="color: #2E6DF8;">@(ViewContext.HttpContext.Session.GetString("UserName") ?? "Ahmet Yılmaz")</div>
                                                    <div class="text-muted" style="font-size: 0.75rem;">Profil Bilgileri</div>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 px-3" href="/Profile" style="color: #333; transition: all 0.2s ease;">
                                            <i class="fas fa-user-circle me-2" style="color: #2E6DF8;"></i>Profil Bilgilerim
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 px-3" href="/Settings" style="color: #333; transition: all 0.2s ease;">
                                            <i class="fas fa-cog me-2" style="color: #2E6DF8;"></i>Hesap Ayarları
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" style="margin: 0.5rem 0; border-color: #E6F7FF;"></li>
                                    <li>
                                        <a class="dropdown-item py-2 px-3 text-danger" href="#" onclick="logout(); return false;" style="transition: all 0.2s ease;">
                                            <i class="fas fa-sign-out-alt me-2"></i>Güvenli Çıkış
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-flex gap-2">
                                <a href="/Login" class="btn" style="background-color: #E6F7FF; color: #2E6DF8; border: 1px solid #2E6DF8; border-radius: 12px; padding: 0.5rem 1.5rem; font-weight: 600; text-decoration: none; transition: all 0.3s ease;">
                                    Giriş Yap
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </nav>
        </header>
    }

