@page
@model figjam2.Pages.CreditCalculatorModel
@{
    ViewData["Title"] = "Kredi Hesaplama";
}

<div class="calculator-container">
    <div class="page-header mb-4 fade-in">
        <h1>
            <i class="fas fa-calculator me-2 text-secondary-custom"></i>
            Kredi Hesaplama
        </h1>
        <p class="text-muted">Kredi tutarı, vade ve faiz oranını girerek aylık ödeme tutarınızı hesaplayın</p>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8 fade-in">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        Kredi Bilgileri
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form id="creditForm">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="creditAmount">
                                    <i class="fas fa-lira-sign me-2"></i>Kredi Tutarı
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₺</span>
                                    <input type="number" 
                                           class="form-control" 
                                           id="creditAmount" 
                                           name="creditAmount"
                                           min="10000" 
                                           max="5000000" 
                                           step="1000"
                                           value="100000"
                                           required>
                                </div>
                                <small class="form-text text-muted">Min: ₺10,000 - Max: ₺5,000,000</small>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="term">
                                    <i class="fas fa-calendar-alt me-2"></i>Vade (Ay)
                                </label>
                                <select class="form-control" id="term" name="term" required>
                                    <option value="12">12 Ay</option>
                                    <option value="24">24 Ay</option>
                                    <option value="36" selected>36 Ay</option>
                                    <option value="48">48 Ay</option>
                                    <option value="60">60 Ay</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="interestRate">
                                    <i class="fas fa-percent me-2"></i>Faiz Oranı (%)
                                </label>
                                <div class="input-group">
                                    <input type="number" 
                                           class="form-control" 
                                           id="interestRate" 
                                           name="interestRate"
                                           min="0.1" 
                                           max="30" 
                                           step="0.1"
                                           value="2.5"
                                           required>
                                    <span class="input-group-text">%</span>
                                </div>
                                <small class="form-text text-muted">Yıllık faiz oranı</small>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="creditType">
                                    <i class="fas fa-tag me-2"></i>Kredi Türü
                                </label>
                                <select class="form-control" id="creditType" name="creditType">
                                    <option value="consumer">İhtiyaç Kredisi</option>
                                    <option value="housing">Konut Kredisi</option>
                                    <option value="vehicle">Taşıt Kredisi</option>
                                    <option value="commercial">Ticari Kredi</option>
                                </select>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="fas fa-calculator me-2"></i>
                                Hesapla
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4 fade-in">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-header bg-secondary-custom text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-chart-pie me-2"></i>
                        Hesaplama Sonucu
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div id="resultContainer" class="text-center">
                        <div class="result-placeholder">
                            <i class="fas fa-calculator fa-4x text-muted mb-3"></i>
                            <p class="text-muted">Bilgileri doldurup hesapla butonuna tıklayın</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Kredi Önerileri -->
    <div class="row mt-5 fade-in">
        <div class="col-12">
            <h3 class="mb-4">
                <i class="fas fa-lightbulb me-2 text-secondary-custom"></i>
                Size Özel Kredi Önerileri
            </h3>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="text-secondary-custom">
                                <i class="fas fa-home me-2"></i>
                                Konut Kredisi
                            </h5>
                            <p class="mb-2">Düşük faiz oranı ile ev sahibi olun</p>
                            <ul class="list-unstyled mb-3">
                                <li><i class="fas fa-check text-success me-2"></i>%1.89 faiz oranı</li>
                                <li><i class="fas fa-check text-success me-2"></i>240 aya kadar vade</li>
                                <li><i class="fas fa-check text-success me-2"></i>Hızlı onay</li>
                            </ul>
                            <button class="btn btn-primary w-100">Başvur</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="text-secondary-custom">
                                <i class="fas fa-car me-2"></i>
                                Taşıt Kredisi
                            </h5>
                            <p class="mb-2">Araç alımında özel kampanya</p>
                            <ul class="list-unstyled mb-3">
                                <li><i class="fas fa-check text-success me-2"></i>%2.19 faiz oranı</li>
                                <li><i class="fas fa-check text-success me-2"></i>60 aya kadar vade</li>
                                <li><i class="fas fa-check text-success me-2"></i>Anında onay</li>
                            </ul>
                            <button class="btn btn-primary w-100">Başvur</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="text-secondary-custom">
                                <i class="fas fa-shopping-cart me-2"></i>
                                İhtiyaç Kredisi
                            </h5>
                            <p class="mb-2">Günlük ihtiyaçlarınız için</p>
                            <ul class="list-unstyled mb-3">
                                <li><i class="fas fa-check text-success me-2"></i>%2.49 faiz oranı</li>
                                <li><i class="fas fa-check text-success me-2"></i>36 aya kadar vade</li>
                                <li><i class="fas fa-check text-success me-2"></i>Kolay başvuru</li>
                            </ul>
                            <button class="btn btn-primary w-100">Başvur</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .calculator-container {
        padding: 2rem 0;
    }

    .page-header {
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 1rem;
    }

    .result-placeholder {
        padding: 2rem 0;
    }

    .result-item {
        padding: 1rem 0;
        border-bottom: 1px solid var(--border-color);
    }

    .result-item:last-child {
        border-bottom: none;
    }

    .result-label {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .result-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--accent-color);
    }
</style>

@section Scripts {
    <script>
        document.getElementById('creditForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const amount = parseFloat(document.getElementById('creditAmount').value);
            const term = parseInt(document.getElementById('term').value);
            const interestRate = parseFloat(document.getElementById('interestRate').value);
            
            // Aylık faiz oranı
            const monthlyRate = interestRate / 100 / 12;
            
            // Aylık ödeme hesaplama (Anüite formülü)
            const monthlyPayment = amount * (monthlyRate * Math.pow(1 + monthlyRate, term)) / 
                                   (Math.pow(1 + monthlyRate, term) - 1);
            
            const totalPayment = monthlyPayment * term;
            const totalInterest = totalPayment - amount;
            
            // Sonuçları göster
            const resultContainer = document.getElementById('resultContainer');
            resultContainer.innerHTML = `
                <div class="result-item">
                    <div class="result-label">Aylık Ödeme</div>
                    <div class="result-value">${formatCurrency(monthlyPayment)}</div>
                </div>
                <div class="result-item">
                    <div class="result-label">Toplam Ödeme</div>
                    <div class="result-value">${formatCurrency(totalPayment)}</div>
                </div>
                <div class="result-item">
                    <div class="result-label">Toplam Faiz</div>
                    <div class="result-value">${formatCurrency(totalInterest)}</div>
                </div>
                <div class="result-item">
                    <div class="result-label">Ana Para</div>
                    <div class="result-value">${formatCurrency(amount)}</div>
                </div>
                <div class="mt-4">
                    <button class="btn btn-primary w-100" onclick="showToast('Kredi başvurusu için yönlendiriliyorsunuz...', 'success')">
                        <i class="fas fa-paper-plane me-2"></i>
                        Kredi Başvurusu Yap
                    </button>
                </div>
            `;
            
            showToast('Hesaplama tamamlandı!', 'success');
        });
    </script>
}

