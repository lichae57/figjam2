<script>
// Profil Resmi Yükleme Fonksiyonları
document.addEventListener('DOMContentLoaded', function() {
    const profileUpload = document.getElementById('profileUpload');
    const avatarUploadArea = document.getElementById('avatarUploadArea');
    const avatarPreview = document.getElementById('avatarPreview');
    const avatarImage = document.getElementById('avatarImage');
    const defaultAvatarIcon = document.getElementById('defaultAvatarIcon');
    const successAlert = document.getElementById('success-alert');
    const btnSave = document.getElementById('btn-save');

    // Dosya seçildiğinde
    if (profileUpload) {
        profileUpload.addEventListener('change', function(e) {
            handleFileSelect(e.target.files[0]);
        });
    }

    // Drag & Drop Event Listeners
    if (avatarUploadArea) {
        // Drag over - dosya üzerine gelindiğinde
        avatarUploadArea.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.stopPropagation();
            avatarUploadArea.classList.add('drag-over');
        });

        // Drag leave - dosya alan dışına çıktığında
        avatarUploadArea.addEventListener('dragleave', function(e) {
            e.preventDefault();
            e.stopPropagation();
            avatarUploadArea.classList.remove('drag-over');
        });

        // Drop - dosya bırakıldığında
        avatarUploadArea.addEventListener('drop', function(e) {
            e.preventDefault();
            e.stopPropagation();
            avatarUploadArea.classList.remove('drag-over');

            const files = e.dataTransfer.files;
            if (files.length > 0 && files[0].type.startsWith('image/')) {
                handleFileSelect(files[0]);
            }
        });

        // Click event - tıklanabilir alan
        avatarUploadArea.style.cursor = 'pointer';
    }

    // Dosya seçimi ve önizleme fonksiyonu
    function handleFileSelect(file) {
        if (!file || !file.type.startsWith('image/')) {
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            // Önizlemeyi göster
            avatarImage.src = e.target.result;
            avatarImage.style.display = 'block';
            defaultAvatarIcon.style.display = 'none';

            // Başarı mesajını göster
            if (successAlert) {
                successAlert.innerHTML = '<i class="fa-solid fa-circle-check me-2"></i> <strong>Başarılı!</strong> Profil resminiz başarıyla güncellendi. <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
                successAlert.className = "alert alert-success alert-dismissible fade show";
                successAlert.style.display = 'block';

                // 3 saniye sonra gizle
                setTimeout(function() {
                    successAlert.style.display = 'none';
                }, 3000);
            }

            // Kaydet butonunu kısa süreliğine "İşleniyor..." moduna al
            if (btnSave) {
                const originalText = btnSave.innerHTML;
                btnSave.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> İşleniyor...';
                btnSave.disabled = true;

                setTimeout(function() {
                    btnSave.innerHTML = originalText;
                    btnSave.disabled = false;
                }, 1500);
            }
        };
        reader.readAsDataURL(file);
    }

    // Profil resmini silme fonksiyonu
    window.removeAvatar = function() {
        // Resmi gizle, varsayılan ikonu göster
        avatarImage.style.display = 'none';
        avatarImage.src = '';
        defaultAvatarIcon.style.display = 'block';

        // Input dosya değerini sıfırla
        if (profileUpload) {
            profileUpload.value = '';
        }

        // Başarı mesajını göster
        if (successAlert) {
            successAlert.innerHTML = '<i class="fa-solid fa-circle-check me-2"></i> <strong>Başarılı!</strong> Profil resminiz başarıyla kaldırıldı. <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
            successAlert.className = "alert alert-success alert-dismissible fade show";
            successAlert.style.display = 'block';

            // 3 saniye sonra gizle
            setTimeout(function() {
                successAlert.style.display = 'none';
            }, 3000);
        }

        // Kaydet butonunu kısa süreliğine "İşleniyor..." moduna al
        if (btnSave) {
            const originalText = btnSave.innerHTML;
            btnSave.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> İşleniyor...';
            btnSave.disabled = true;

            setTimeout(function() {
                btnSave.innerHTML = originalText;
                btnSave.disabled = false;
            }, 1500);
        }
    };
});
</script>

