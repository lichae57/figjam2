</div>

<script>
        // Oturum Zaman Aşımı Ayarlarını Yükle ve Kaydet
        document.addEventListener('DOMContentLoaded', function() {
            var timeoutSelect = document.getElementById('sessionTimeoutSelect');
            if (timeoutSelect) {
                // Değişiklik olduğunda session'a kaydet
                timeoutSelect.addEventListener('change', function() {
                    var selectedValue = this.value;
                    
                    // FormData ile POST isteği gönder
                    var formData = new FormData();
                    formData.append('timeoutMinutes', selectedValue);
                    
                    // Anti-forgery token ekle
                    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    if (token) {
                        formData.append('__RequestVerificationToken', token);
                    }
                    
                    fetch('/Settings?handler=UpdateSessionTimeout', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': token
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Başarı mesajı göster
                            var alertBox = document.getElementById('success-alert');
                            if (alertBox) {
                                alertBox.innerHTML = '<i class="fa-solid fa-circle-check me-2"></i> <strong>Başarılı!</strong> Oturum zaman aşımı ayarı güncellendi. <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
                                alertBox.className = "alert alert-success alert-dismissible fade show";
                                alertBox.style.display = 'block';
                                
                                setTimeout(function() {
                                    alertBox.style.display = 'none';
                                }, 3000);
                            }
                            
                            // Sayfayı yenile (timeout mekanizmasının yeni değeri alması için)
                            setTimeout(function() {
                                window.location.reload();
                            }, 1000);
                        }
                    })
                    .catch(error => {
                        console.error('Hata:', error);
                    });
                });
            }
        });

        function directOpenModal(btn) {
    console.log("Buton tıklandı");
    document.getElementById('finalModal').style.display = 'flex';
    
    document.getElementById('confirmAction').onclick = function() {
        document.getElementById('finalModal').style.display = 'none';
        btn.innerHTML = 'Kapatılıyor...';
        btn.disabled = true;
        
        setTimeout(() => {
            btn.innerHTML = 'Sonlandırıldı';
            btn.className = 'btn btn-secondary btn-sm disabled';
            btn.closest('.d-flex').style.opacity = '0.4';
            
            // Tepedeki alert kutusunu bul ve göster
            const alert = document.getElementById('success-alert');
            if(alert) alert.style.display = 'block';
        }, 1000);
    };
}
</script>

