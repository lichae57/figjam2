@page
@model ErrorModel
@{
    ViewData["Title"] = "Hata";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 text-center">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <i class="fas fa-exclamation-triangle fa-4x text-danger mb-4"></i>
                    <h1 class="text-danger mb-3">Hata</h1>
                    <h2 class="text-danger mb-4">İsteğiniz işlenirken bir hata oluştu.</h2>

                    @if (Model.ShowRequestId)
                    {
                        <p class="mb-3">
                            <strong>İstek ID:</strong> <code>@Model.RequestId</code>
                        </p>
                    }

                    <div class="mt-4">
                        <a href="/Dashboard" class="btn btn-primary">
                            <i class="fas fa-home me-2"></i>Ana Sayfaya Dön
                        </a>
                    </div>

                    <hr class="my-4">

                    <h3 class="h5 mb-3">Geliştirme Modu</h3>
                    <p class="text-muted small">
                        <strong>Development</strong> ortamına geçmek, oluşan hata hakkında detaylı bilgi gösterir.
                    </p>
                    <p class="text-muted small">
                        <strong>Geliştirme ortamı dağıtılan uygulamalarda etkinleştirilmemelidir.</strong>
                        Bu, kullanıcılara istisnalardan hassas bilgilerin gösterilmesine neden olabilir.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
