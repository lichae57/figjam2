@page
@model figjam2.Pages.ServicesModel
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="services-container">
    <div class="page-header mb-4 fade-in">
        <h1>
            <i class="fas fa-concierge-bell me-2 text-secondary-custom"></i>
            Hizmetlerimiz
        </h1>
        <p class="text-muted">Tüm bankacılık hizmetlerimize buradan erişebilirsiniz</p>
    </div>

    <div class="row g-4">
        <!-- Hesap İşlemleri -->
        <div class="col-12 col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-wallet fa-3x text-secondary-custom"></i>
                    </div>
                    <h4 class="mb-3">Hesap İşlemleri</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Hesap Özeti
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Havale/EFT
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Virman İşlemleri
                        </li>
                    </ul>
                    <button class="btn btn-primary w-100 mt-3">
                        Detaylı Bilgi <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Kredi İşlemleri -->
        <div class="col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-hand-holding-usd fa-3x text-secondary-custom"></i>
                    </div>
                    <h4 class="mb-3">Kredi İşlemleri</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Kredi Başvurusu
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Kredi Hesaplama
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Kredi Ödemeleri
                        </li>
                    </ul>
                    <a href="/CreditCalculator" class="btn btn-primary w-100 mt-3">
                        Kredi Hesapla <i class="fas fa-calculator ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Kart İşlemleri -->
        <div class="col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-credit-card fa-3x text-secondary-custom"></i>
                    </div>
                    <h4 class="mb-3">Kart İşlemleri</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Kart Başvurusu
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Kart Limiti Yönetimi
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Kart İşlem Geçmişi
                        </li>
                    </ul>
                    <button class="btn btn-primary w-100 mt-3">
                        Detaylı Bilgi <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Fatura Ödemeleri -->
        <div class="col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-file-invoice-dollar fa-3x text-secondary-custom"></i>
                    </div>
                    <h4 class="mb-3">Fatura Ödemeleri</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Elektrik Faturası
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Su Faturası
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Doğalgaz Faturası
                        </li>
                    </ul>
                    <a href="/Reports" class="btn btn-primary w-100 mt-3">
                        Faturaları Görüntüle <i class="fas fa-file-invoice ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Yatırım İşlemleri -->
        <div class="col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-chart-line fa-3x text-secondary-custom"></i>
                    </div>
                    <h4 class="mb-3">Yatırım İşlemleri</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Döviz İşlemleri
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Altın İşlemleri
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Fon Yatırımları
                        </li>
                    </ul>
                    <button class="btn btn-primary w-100 mt-3">
                        Detaylı Bilgi <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Sigorta İşlemleri -->
        <div class="col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-shield-alt fa-3x text-secondary-custom"></i>
                    </div>
                    <h4 class="mb-3">Sigorta İşlemleri</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Hayat Sigortası
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Konut Sigortası
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Kasko Sigortası
                        </li>
                    </ul>
                    <button class="btn btn-primary w-100 mt-3">
                        Detaylı Bilgi <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .services-container {
        padding: 2rem 0;
    }

    .page-header {
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 1rem;
    }

    .service-card {
        transition: all 0.3s ease;
    }

    .service-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }

    .service-icon {
        text-align: center;
    }
</style>

