@page
@model figjam2.Pages.ServicesModel
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="services-container">
    <div class="page-header mb-4 fade-in">
        <h1>
            <i class="fas fa-concierge-bell me-2 text-secondary-custom"></i>
            Hizmetlerimiz
        </h1>
        <p class="text-muted">Tüm bankacılık hizmetlerimize buradan erişebilirsiniz</p>
    </div>

    <div class="row g-4">
        <!-- Hesap İşlemleri -->
        <div class="col-12 col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-wallet fa-3x text-secondary-custom"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Hesap İşlemleri</h5>
                    <p class="text-muted mb-4">Hesap bakiyenizi görüntüleyin, para transferi yapın ve hesap ekstrelerinize erişin.</p>
                    <a href="/Dashboard" class="btn btn-sm btn-outline-primary-custom">
                        Detaylar <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Kredi Hizmetleri -->
        <div class="col-12 col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-hand-holding-usd fa-3x text-secondary-custom"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Kredi Hizmetleri</h5>
                    <p class="text-muted mb-4">İhtiyaç, konut, taşıt kredisi ve daha fazlası için başvuru yapın.</p>
                    <a href="/CreditCalculator" class="btn btn-sm btn-outline-primary-custom">
                        Detaylar <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Yatırım Ürünleri -->
        <div class="col-12 col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-chart-line fa-3x text-secondary-custom"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Yatırım Ürünleri</h5>
                    <p class="text-muted mb-4">Döviz, altın, hisse senedi ve daha fazla yatırım seçeneği.</p>
                    <a href="/Dashboard" class="btn btn-sm btn-outline-primary-custom">
                        Detaylar <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Kart İşlemleri -->
        <div class="col-12 col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-credit-card fa-3x text-secondary-custom"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Kart İşlemleri</h5>
                    <p class="text-muted mb-4">Kredi kartı, banka kartı işlemleri ve kart limitlerinizi yönetin.</p>
                    <a href="/Dashboard" class="btn btn-sm btn-outline-primary-custom">
                        Detaylar <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Dijital Bankacılık -->
        <div class="col-12 col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-mobile-alt fa-3x text-secondary-custom"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Dijital Bankacılık</h5>
                    <p class="text-muted mb-4">Mobil uygulama, SMS bankacılık ve dijital cüzdan hizmetleri.</p>
                    <a href="/Dashboard" class="btn btn-sm btn-outline-primary-custom">
                        Detaylar <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Müşteri Hizmetleri -->
        <div class="col-12 col-md-6 col-lg-4 fade-in">
            <div class="card h-100 service-card">
                <div class="card-body p-4">
                    <div class="service-icon mb-3">
                        <i class="fas fa-headset fa-3x text-secondary-custom"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Müşteri Hizmetleri</h5>
                    <p class="text-muted mb-4">7/24 müşteri desteği, şube randevu ve canlı destek hizmetleri.</p>
                    <a href="/Dashboard" class="btn btn-sm btn-outline-primary-custom">
                        Detaylar <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .services-container {
        padding: 2rem 0;
    }

    .service-card {
        transition: all 0.3s ease;
        border-radius: 16px;
    }

    .service-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-lg) !important;
    }

    .service-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--secondary-color) 0%, var(--accent-color) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem auto;
        color: white;
        font-size: 2.5rem;
        box-shadow: var(--shadow-md);
    }

    .service-icon i {
        color: white !important;
    }

    .btn-outline-primary-custom {
        border-color: var(--secondary-color);
        color: var(--secondary-color);
    }

    .btn-outline-primary-custom:hover {
        background-color: var(--secondary-color);
        color: white;
    }
</style>

