@page
@model figjam2.Pages.LoginModel
@{
    ViewData["Title"] = "Giriş Yap";
    ViewData["ShowNavbar"] = false;
    ViewData["ShowFooter"] = false;
}

<div class="login-container">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-5 col-lg-4">
                <div class="card fade-in">
                    <div class="card-header text-center">
                        <h2 class="mb-0">
                            <i class="fas fa-university me-2"></i>
                            İnteraktif Şube
                        </h2>
                        <p class="mb-0 mt-2" style="font-size: 0.9rem; opacity: 0.9;">Hoş Geldiniz</p>
                    </div>
                    <div class="card-body p-4">
                        <form id="loginForm" data-validate="true" method="post">
                            <div class="form-group">
                                <label class="form-label" for="identifier">
                                    <i class="fas fa-id-card me-2"></i>TC Kimlik No veya Telefon
                                </label>
                                <input type="text" 
                                       class="form-control" 
                                       id="identifier" 
                                       name="identifier"
                                       data-mask="tckn"
                                       placeholder="5XX XXX XX XX"
                                       required
                                       autocomplete="off">
                                <small class="form-text text-muted mt-1">
                                    <i class="fas fa-info-circle me-1"></i>
                                    TC Kimlik numaranızı veya telefon numaranızı giriniz
                                </small>
                            </div>

                            <div class="form-group mt-4">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-arrow-right me-2"></i>
                                    Devam Et
                                </button>
                            </div>

                            <div class="text-center mt-3">
                                <small class="text-muted">
                                    <i class="fas fa-shield-alt me-1"></i>
                                    Güvenli bağlantı ile korunmaktasınız
                                </small>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a href="#" class="text-secondary-custom" style="text-decoration: none;">
                        <i class="fas fa-question-circle me-1"></i>
                        Yardıma mı ihtiyacınız var?
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .login-container {
        background: linear-gradient(135deg, #222854 0%, #2E6DF8 100%);
        min-height: 100vh;
    }

    .card {
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    }

    .form-control {
        padding: 1rem;
        font-size: 1.1rem;
    }

    .form-control:focus {
        border-color: var(--secondary-color);
        box-shadow: 0 0 0 0.2rem rgba(46, 109, 248, 0.25);
    }
</style>

@section Scripts {
    <script>
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const identifier = document.getElementById('identifier').value;
            const cleanIdentifier = identifier.replace(/\D/g, '');
            
            if (cleanIdentifier.length < 10) {
                showToast('Lütfen geçerli bir TC Kimlik No veya telefon numarası giriniz.', 'error');
                return;
            }
            
            // PIN doğrulama sayfasına yönlendir
            window.location.href = '/PinVerification';
        });
    </script>
}

