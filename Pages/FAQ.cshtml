@page
@model figjam2.Pages.FAQModel
@{
    ViewData["Title"] = "Sık Sorulan Sorular";
}

<div class="faq-container">
    <div class="page-header mb-4 fade-in">
        <h1>
            <i class="fas fa-question-circle me-2 text-secondary-custom"></i>
            Sık Sorulan Sorular
        </h1>
        <p class="text-muted">Merak ettiğiniz soruların yanıtlarını burada bulabilirsiniz</p>
    </div>

    <div class="row">
        <div class="col-lg-8 fade-in">
            <!-- Arama Kutusu -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" 
                               class="form-control" 
                               id="searchInput"
                               placeholder="Sorunuzu yazın...">
                    </div>
                </div>
            </div>

            <!-- Kategoriler -->
            <div class="mb-4">
                <h3 class="mb-3">Kategoriler</h3>
                <div class="row g-2">
                    <div class="col-md-3 col-sm-6">
                        <button class="btn btn-outline w-100 category-btn active" data-category="all">
                            Tümü
                        </button>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <button class="btn btn-outline w-100 category-btn" data-category="account">
                            Hesap İşlemleri
                        </button>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <button class="btn btn-outline w-100 category-btn" data-category="credit">
                            Kredi İşlemleri
                        </button>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <button class="btn btn-outline w-100 category-btn" data-category="security">
                            Güvenlik
                        </button>
                    </div>
                </div>
            </div>

            <!-- SSS Listesi -->
            <div class="accordion" id="faqAccordion">
                <div class="card mb-2 faq-item" data-category="account">
                    <div class="card-header" id="heading1">
                        <h5 class="mb-0">
                            <button class="btn btn-link w-100 text-start text-decoration-none" 
                                    type="button" 
                                    data-bs-toggle="collapse" 
                                    data-bs-target="#collapse1">
                                <i class="fas fa-chevron-right me-2"></i>
                                Hesap açmak için hangi belgeler gereklidir?
                            </button>
                        </h5>
                    </div>
                    <div id="collapse1" class="collapse" data-bs-parent="#faqAccordion">
                        <div class="card-body">
                            Hesap açmak için TC Kimlik belgeniz ve ikametgah belgeniz yeterlidir. 
                            Online başvuru yapabilir veya şubelerimizden başvurabilirsiniz.
                        </div>
                    </div>
                </div>

                <div class="card mb-2 faq-item" data-category="credit">
                    <div class="card-header" id="heading2">
                        <h5 class="mb-0">
                            <button class="btn btn-link w-100 text-start text-decoration-none" 
                                    type="button" 
                                    data-bs-toggle="collapse" 
                                    data-bs-target="#collapse2">
                                <i class="fas fa-chevron-right me-2"></i>
                                Kredi başvurusu nasıl yapılır?
                            </button>
                        </h5>
                    </div>
                    <div id="collapse2" class="collapse" data-bs-parent="#faqAccordion">
                        <div class="card-body">
                            Kredi başvurunuzu online olarak yapabilirsiniz. Kredi Hesaplama sayfasından 
                            uygun kredi türünü seçerek başvuru formunu doldurabilirsiniz. 
                            Başvurunuz 24 saat içinde değerlendirilecektir.
                        </div>
                    </div>
                </div>

                <div class="card mb-2 faq-item" data-category="account">
                    <div class="card-header" id="heading3">
                        <h5 class="mb-0">
                            <button class="btn btn-link w-100 text-start text-decoration-none" 
                                    type="button" 
                                    data-bs-toggle="collapse" 
                                    data-bs-target="#collapse3">
                                <i class="fas fa-chevron-right me-2"></i>
                                Havale/EFT işlemi nasıl yapılır?
                            </button>
                        </h5>
                    </div>
                    <div id="collapse3" class="collapse" data-bs-parent="#faqAccordion">
                        <div class="card-body">
                            Hizmetler sayfasından Hesap İşlemleri bölümüne giriş yaparak havale/EFT 
                            işleminizi gerçekleştirebilirsiniz. Alıcı bilgilerini girdikten sonra 
                            işleminiz anında gerçekleşecektir.
                        </div>
                    </div>
                </div>

                <div class="card mb-2 faq-item" data-category="security">
                    <div class="card-header" id="heading4">
                        <h5 class="mb-0">
                            <button class="btn btn-link w-100 text-start text-decoration-none" 
                                    type="button" 
                                    data-bs-toggle="collapse" 
                                    data-bs-target="#collapse4">
                                <i class="fas fa-chevron-right me-2"></i>
                                PIN kodumu unuttum, ne yapmalıyım?
                            </button>
                        </h5>
                    </div>
                    <div id="collapse4" class="collapse" data-bs-parent="#faqAccordion">
                        <div class="card-body">
                            PIN kodunuzu unuttuysanız, müşteri hizmetlerimizi arayarak veya şubelerimizden 
                            başvurarak yeni PIN kodu talep edebilirsiniz. Güvenlik kontrolünden sonra 
                            yeni PIN kodunuz size iletilecektir.
                        </div>
                    </div>
                </div>

                <div class="card mb-2 faq-item" data-category="account">
                    <div class="card-header" id="heading5">
                        <h5 class="mb-0">
                            <button class="btn btn-link w-100 text-start text-decoration-none" 
                                    type="button" 
                                    data-bs-toggle="collapse" 
                                    data-bs-target="#collapse5">
                                <i class="fas fa-chevron-right me-2"></i>
                                Faturalarımı nasıl ödeyebilirim?
                            </button>
                        </h5>
                    </div>
                    <div id="collapse5" class="collapse" data-bs-parent="#faqAccordion">
                        <div class="card-body">
                            Raporlar & Faturalar sayfasından tüm faturalarınızı görüntüleyebilir ve 
                            ödeme yapabilirsiniz. Ödeme işlemi anında gerçekleşir ve onay mesajı alırsınız.
                        </div>
                    </div>
                </div>

                <div class="card mb-2 faq-item" data-category="security">
                    <div class="card-header" id="heading6">
                        <h5 class="mb-0">
                            <button class="btn btn-link w-100 text-start text-decoration-none" 
                                    type="button" 
                                    data-bs-toggle="collapse" 
                                    data-bs-target="#collapse6">
                                <i class="fas fa-chevron-right me-2"></i>
                                İki faktörlü doğrulama nedir?
                            </button>
                        </h5>
                    </div>
                    <div id="collapse6" class="collapse" data-bs-parent="#faqAccordion">
                        <div class="card-body">
                            İki faktörlü doğrulama, hesabınızın güvenliğini artıran bir özelliktir. 
                            Giriş yaparken PIN kodunuzun yanı sıra telefonunuza gelen doğrulama kodunu 
                            da girmeniz gerekir. Bu özelliği Profil sayfasından aktif edebilirsiniz.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 fade-in">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-headset me-2"></i>
                        Yardıma mı ihtiyacınız var?
                    </h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">Sorularınızın yanıtını bulamadıysanız bizimle iletişime geçin.</p>
                    <button class="btn btn-primary w-100 mb-2">
                        <i class="fas fa-phone me-2"></i>
                        0850 XXX XX XX
                    </button>
                    <button class="btn btn-outline w-100 mb-2">
                        <i class="fas fa-envelope me-2"></i>
                        E-posta Gönder
                    </button>
                    <button class="btn btn-outline w-100">
                        <i class="fas fa-comments me-2"></i>
                        Canlı Destek
                    </button>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-book me-2"></i>
                        Kullanım Kılavuzu
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a href="#" class="text-decoration-none">
                                <i class="fas fa-file-pdf me-2 text-danger"></i>
                                Kullanım Kılavuzu (PDF)
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="#" class="text-decoration-none">
                                <i class="fas fa-video me-2 text-danger"></i>
                                Video Eğitimler
                            </a>
                        </li>
                        <li>
                            <a href="#" class="text-decoration-none">
                                <i class="fas fa-download me-2 text-danger"></i>
                                Mobil Uygulama
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .faq-container {
        padding: 2rem 0;
    }

    .page-header {
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 1rem;
    }

    .category-btn.active {
        background-color: var(--secondary-color);
        color: white;
        border-color: var(--secondary-color);
    }

    .faq-item {
        transition: all 0.3s ease;
    }

    .faq-item.hidden {
        display: none;
    }

    .card-header button {
        color: var(--text-primary);
        font-weight: 500;
    }

    .card-header button:hover {
        color: var(--secondary-color);
    }

    .card-header button i {
        transition: transform 0.3s ease;
    }

    .card-header button[aria-expanded="true"] i {
        transform: rotate(90deg);
    }
</style>

@section Scripts {
    <script>
        // Kategori filtreleme
        document.querySelectorAll('.category-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                
                const category = this.dataset.category;
                const items = document.querySelectorAll('.faq-item');
                
                items.forEach(item => {
                    if (category === 'all' || item.dataset.category === category) {
                        item.classList.remove('hidden');
                    } else {
                        item.classList.add('hidden');
                    }
                });
            });
        });

        // Arama fonksiyonu
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const items = document.querySelectorAll('.faq-item');
            
            items.forEach(item => {
                const text = item.textContent.toLowerCase();
                if (text.includes(searchTerm)) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
        });
    </script>
}

