@page "/CreditApplication"
@model figjam2.Pages.CreditApplicationModel
@{
    ViewData["Title"] = "Kredi Başvurusu";
}

<div class="application-container">
    <div class="page-header mb-4 fade-in">
        <h1>
            <i class="fas fa-file-alt me-2 text-secondary-custom"></i>
            Kredi Başvurusu
        </h1>
        <p class="text-muted">Kredi başvurunuzu tamamlamak için lütfen aşağıdaki bilgileri doldurun</p>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8 offset-lg-2 fade-in">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0 text-white">
                        <i class="fas fa-info-circle me-2"></i>
                        Başvuru Bilgileri
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form id="applicationForm">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="creditTypeDisplay">
                                    <i class="fas fa-tag me-2"></i>Kredi Türü
                                </label>
                                <input type="text" 
                                       class="form-control" 
                                       id="creditTypeDisplay" 
                                       readonly
                                       value="@Model.CreditTypeName">
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="fullName">
                                    <i class="fas fa-user me-2"></i>Ad Soyad
                                </label>
                                <input type="text" 
                                       class="form-control" 
                                       id="fullName" 
                                       name="fullName"
                                       required>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="tcNo">
                                    <i class="fas fa-id-card me-2"></i>TC Kimlik No
                                </label>
                                <input type="text" 
                                       class="form-control" 
                                       id="tcNo" 
                                       name="tcNo"
                                       maxlength="11"
                                       pattern="[0-9]{11}"
                                       required>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="phone">
                                    <i class="fas fa-phone me-2"></i>Telefon
                                </label>
                                <input type="tel" 
                                       class="form-control" 
                                       id="phone" 
                                       name="phone"
                                       placeholder="05XX XXX XX XX"
                                       required>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="email">
                                    <i class="fas fa-envelope me-2"></i>E-posta
                                </label>
                                <input type="email" 
                                       class="form-control" 
                                       id="email" 
                                       name="email"
                                       required>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="requestedAmount">
                                    <i class="fas fa-lira-sign me-2"></i>Talep Edilen Tutar
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₺</span>
                                    <input type="number" 
                                           class="form-control" 
                                           id="requestedAmount" 
                                           name="requestedAmount"
                                           min="10000" 
                                           max="5000000" 
                                           step="1000"
                                           required>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="monthlyIncome">
                                    <i class="fas fa-money-bill-wave me-2"></i>Aylık Gelir
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₺</span>
                                    <input type="number" 
                                           class="form-control" 
                                           id="monthlyIncome" 
                                           name="monthlyIncome"
                                           min="0" 
                                           step="100"
                                           required>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label" for="address">
                                    <i class="fas fa-map-marker-alt me-2"></i>Adres
                                </label>
                                <textarea class="form-control" 
                                          id="address" 
                                          name="address"
                                          rows="3"
                                          required></textarea>
                            </div>

                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" 
                                           type="checkbox" 
                                           id="terms" 
                                           name="terms"
                                           required>
                                    <label class="form-check-label" for="terms">
                                        <a href="#" class="text-primary">Kredi başvuru şartlarını</a> okudum ve kabul ediyorum
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="fas fa-paper-plane me-2"></i>
                                Başvuruyu Gönder
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .application-container {
        padding: 2rem 0;
    }

    .page-header {
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 1rem;
        padding-left: 5rem;
    }

    .card-header {
        background-color: var(--secondary-color);
    }

    .card-header h4 {
        padding-left: 0.5rem;
    }
</style>

@section Scripts {
    <script>
        document.getElementById('applicationForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Form validasyonu
            const form = this;
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // Başvuru gönderiliyor simülasyonu
            showToast('Başvurunuz gönderiliyor...', 'info');
            
            setTimeout(function() {
                showToast('Başvurunuz başarıyla gönderildi! En kısa sürede size dönüş yapacağız.', 'success');
                
                // 2 saniye sonra ana sayfaya yönlendir
                setTimeout(function() {
                    window.location.href = '/CreditCalculator';
                }, 2000);
            }, 1500);
        });

        // TC Kimlik No sadece rakam girişi
        document.getElementById('tcNo').addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        // Telefon formatı
        document.getElementById('phone').addEventListener('input', function(e) {
            let value = this.value.replace(/[^0-9]/g, '');
            if (value.length > 0 && value[0] !== '0') {
                value = '0' + value;
            }
            if (value.length > 11) {
                value = value.substring(0, 11);
            }
            this.value = value;
        });
    </script>
}

