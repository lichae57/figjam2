@page
@model figjam2.Pages.ReportsModel
@{
    ViewData["Title"] = "Raporlar & Faturalar";
}

<div class="reports-container">
    <div class="page-header mb-4 fade-in">
        <h1>
            <i class="fas fa-file-invoice me-2 text-secondary-custom"></i>
            Raporlar & Faturalar
        </h1>
        <p class="text-muted">Faturalarınızı görüntüleyin, ödeyin ve işlem geçmişinizi takip edin</p>
    </div>

    <!-- Filtreler -->
    <div class="card mb-4 fade-in">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Fatura Türü</label>
                    <select class="form-control" id="billType">
                        <option value="">Tümü</option>
                        <option value="electricity">Elektrik</option>
                        <option value="water">Su</option>
                        <option value="gas">Doğalgaz</option>
                        <option value="internet">İnternet</option>
                        <option value="phone">Telefon</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Durum</label>
                    <select class="form-control" id="status">
                        <option value="">Tümü</option>
                        <option value="paid">Ödendi</option>
                        <option value="unpaid">Ödenmedi</option>
                        <option value="pending">Beklemede</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Başlangıç Tarihi</label>
                    <input type="date" class="form-control" id="startDate">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Bitiş Tarihi</label>
                    <input type="date" class="form-control" id="endDate">
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-primary" onclick="filterBills()">
                    <i class="fas fa-filter me-2"></i>Filtrele
                </button>
                <button class="btn btn-outline" onclick="resetFilters()">
                    <i class="fas fa-redo me-2"></i>Sıfırla
                </button>
            </div>
        </div>
    </div>

    <!-- Fatura Listesi -->
    <div class="row g-4">
        <div class="col-lg-8 fade-in">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="fas fa-list me-2"></i>
                        Faturalar
                    </h4>
                    <span class="badge bg-secondary-custom" id="billCount">12 Fatura</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead style="background-color: var(--bg-light);">
                                <tr>
                                    <th>Fatura Türü</th>
                                    <th>Tarih</th>
                                    <th>Tutar</th>
                                    <th>Durum</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody id="billsTable">
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-bolt text-warning fa-2x me-3"></i>
                                            <div>
                                                <strong>Elektrik Faturası</strong>
                                                <br>
                                                <small class="text-muted">Fatura No: 20250115001</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>15 Ocak 2025</td>
                                    <td><strong>₺245.80</strong></td>
                                    <td><span class="badge bg-success">Ödendi</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline" onclick="viewBill(1)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline" onclick="downloadBill(1)">
                                            <i class="fas fa-download"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-tint text-info fa-2x me-3"></i>
                                            <div>
                                                <strong>Su Faturası</strong>
                                                <br>
                                                <small class="text-muted">Fatura No: 20250114002</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>14 Ocak 2025</td>
                                    <td><strong>₺125.50</strong></td>
                                    <td><span class="badge bg-success">Ödendi</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline" onclick="viewBill(2)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline" onclick="downloadBill(2)">
                                            <i class="fas fa-download"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-fire text-danger fa-2x me-3"></i>
                                            <div>
                                                <strong>Doğalgaz Faturası</strong>
                                                <br>
                                                <small class="text-muted">Fatura No: 20250120003</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>20 Ocak 2025</td>
                                    <td><strong>₺385.20</strong></td>
                                    <td><span class="badge bg-warning">Beklemede</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-primary" onclick="payBill(3)">
                                            <i class="fas fa-credit-card me-1"></i>Öde
                                        </button>
                                        <button class="btn btn-sm btn-outline" onclick="viewBill(3)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-wifi text-secondary-custom fa-2x me-3"></i>
                                            <div>
                                                <strong>İnternet Faturası</strong>
                                                <br>
                                                <small class="text-muted">Fatura No: 20250118004</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>18 Ocak 2025</td>
                                    <td><strong>₺199.90</strong></td>
                                    <td><span class="badge bg-danger">Ödenmedi</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-primary" onclick="payBill(4)">
                                            <i class="fas fa-credit-card me-1"></i>Öde
                                        </button>
                                        <button class="btn btn-sm btn-outline" onclick="viewBill(4)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Özet Bilgiler -->
        <div class="col-lg-4 fade-in">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar me-2"></i>
                        Özet
                    </h5>
                </div>
                <div class="card-body">
                    <div class="summary-item mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Toplam Fatura</span>
                            <strong>12</strong>
                        </div>
                    </div>
                    <div class="summary-item mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Ödenen</span>
                            <strong class="text-success">8</strong>
                        </div>
                    </div>
                    <div class="summary-item mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Bekleyen</span>
                            <strong class="text-warning">2</strong>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Ödenmemiş</span>
                            <strong class="text-danger">2</strong>
                        </div>
                    </div>
                    <hr>
                    <div class="summary-item">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Toplam Tutar</span>
                            <strong class="text-accent-custom">₺956.40</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-download me-2"></i>
                        Hızlı İşlemler
                    </h5>
                </div>
                <div class="card-body">
                    <button class="btn btn-primary w-100 mb-2">
                        <i class="fas fa-file-pdf me-2"></i>
                        PDF Olarak İndir
                    </button>
                    <button class="btn btn-outline w-100">
                        <i class="fas fa-envelope me-2"></i>
                        E-posta ile Gönder
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .reports-container {
        padding: 2rem 0;
    }

    .page-header {
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 1rem;
    }

    .table th {
        font-weight: 600;
        color: var(--text-primary);
        border-bottom: 2px solid var(--border-color);
    }

    .table td {
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background-color: var(--bg-light);
    }
</style>

@section Scripts {
    <script>
        function filterBills() {
            showToast('Filtreleme yapılıyor...', 'success');
            // Filtreleme işlemi burada yapılacak
        }

        function resetFilters() {
            document.getElementById('billType').value = '';
            document.getElementById('status').value = '';
            document.getElementById('startDate').value = '';
            document.getElementById('endDate').value = '';
            showToast('Filtreler sıfırlandı', 'success');
        }

        function viewBill(id) {
            showToast('Fatura görüntüleniyor...', 'success');
            // Fatura detay sayfasına yönlendirme
        }

        function downloadBill(id) {
            showToast('Fatura indiriliyor...', 'success');
            // PDF indirme işlemi
        }

        function payBill(id) {
            if (confirm('Bu faturayı ödemek istediğinize emin misiniz?')) {
                showToast('Ödeme işlemi başlatılıyor...', 'success');
                // Ödeme işlemi
            }
        }
    </script>
}

