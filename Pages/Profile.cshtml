@page
@model figjam2.Pages.ProfileModel
@{
    ViewData["Title"] = "Profil";
}

<div class="profile_container">
    <div class="page_header mb-4 fade-in">
        <h1>
            <i class="fas fa-user me-2 text-secondary-custom"></i>
            Profil Bilgilerim
        </h1>
        <p class="text-muted">Kişisel bilgilerinizi görüntüleyin ve yönetin</p>
    </div>

    <div class="row">
        <div class="col-12 col-lg-4 fade-in">
            <div class="card">
                <div class="card-body text-center">
                    <div class="profile_avatar mb-3">
                        <i class="fas fa-user-circle fa-5x text-secondary-custom"></i>
                    </div>
                    <h4>@(HttpContext.Session.GetString("UserName") ?? "Kullanıcı")</h4>
                    <p class="text-muted mb-3">Müşteri No: @{
                        var identifier = HttpContext.Session.GetString("Identifier");
                        if (!string.IsNullOrEmpty(identifier) && identifier.Length >= 8)
                        {
                            @identifier.Substring(0, 8)
                        }
                        else
                        {
                            @("12345678")
                        }
                    }</p>
                    <a href="/ProfileManagement" class="btn btn-primary w-100">
                        <i class="fas fa-edit me-2"></i>
                        Bilgileri Düzenle
                    </a>
                </div>
            </div>

        </div>

        <div class="col-12 col-lg-8 fade-in">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        Kişisel Bilgiler
                    </h4>
                </div>
                <div class="card-body">
                    <h5 class="mb-3">
                        <i class="fas fa-user me-2 text-secondary-custom"></i>
                        Kullanıcı Bilgileri
                    </h5>
                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted">Ad:</label>
                            <p class="form-control-plaintext"><strong>Ahmet</strong></p>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted">Soyad:</label>
                            <p class="form-control-plaintext"><strong>Yılmaz</strong></p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted">TC Kimlik No:</label>
                            <p class="form-control-plaintext"><strong>12*****78</strong></p>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted">Doğum Tarihi:</label>
                            <p class="form-control-plaintext"><strong>15 Mart 1985</strong></p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted">E-posta:</label>
                            <p class="form-control-plaintext"><strong>@(HttpContext.Session.GetString("UserEmail") ?? "ahmet.yilmaz@gmail.com")</strong></p>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted">Telefon:</label>
                            <p class="form-control-plaintext"><strong>@(HttpContext.Session.GetString("UserPhone") ?? "5XX XXX XX XX")</strong></p>
                        </div>
                    </div>

                    <hr>

                    <h5 class="mb-3">
                        <i class="fas fa-map-marker-alt me-2 text-secondary-custom"></i>
                        Adres Bilgileri
                    </h5>
                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label text-muted">Adres:</label>
                            <p class="form-control-plaintext">
                                <strong>@(HttpContext.Session.GetString("UserAddress") ?? "Atatürk Mahallesi, Cumhuriyet Caddesi No: 123")</strong>
                            </p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label text-muted">İl:</label>
                            <p class="form-control-plaintext"><strong>@(HttpContext.Session.GetString("UserCity") ?? "İstanbul")</strong></p>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted">İlçe:</label>
                            <p class="form-control-plaintext"><strong>@(HttpContext.Session.GetString("UserDistrict") ?? "Kadıköy")</strong></p>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted">Posta Kodu:</label>
                            <p class="form-control-plaintext"><strong>@(HttpContext.Session.GetString("UserPostalCode") ?? "34700")</strong></p>
                        </div>
                    </div>

                    <hr>

                    <h5 class="mb-3">
                        <i class="fas fa-briefcase me-2 text-secondary-custom"></i>
                        İş Bilgileri
                    </h5>
                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted">Meslek:</label>
                            <p class="form-control-plaintext"><strong>@(HttpContext.Session.GetString("UserJob") ?? "Yazılım Geliştirici")</strong></p>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted">Gelir:</label>
                            <p class="form-control-plaintext"><strong>@{
                                var income = HttpContext.Session.GetString("UserIncome") ?? "20000-30000";
                                string incomeDisplay = income switch
                                {
                                    "0-10000" => "₺0 - ₺10 bin",
                                    "10000-20000" => "₺10 - ₺20 bin",
                                    "20000-30000" => "₺20 - ₺30 bin",
                                    "30000-40000" => "₺30 - ₺40 bin",
                                    "40000-50000" => "₺40 - ₺50 bin",
                                    "50000+" => "₺50+",
                                    _ => "₺20 - ₺30 bin"
                                };
                                @incomeDisplay
                            }</strong></p>
                        </div>
                    </div>

                    <hr>

                    <h5 class="mb-3">
                        <i class="fas fa-shield-alt me-2 text-secondary-custom"></i>
                        Güvenlik
                    </h5>
                    <div class="security_item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>İki Faktörlü Doğrulama</strong>
                                <br>
                                <small class="text-muted">Aktif</small>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" checked>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .profile_container {
        padding: 2rem 0;
        margin: -1cm 5cm 0 5cm;
    }

    .page_header {
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 1rem;
        margin-top: 1cm;
    }

    .profile_avatar {
        margin: 0 auto;
    }

    .form-control-plaintext {
        padding: 0.5rem 0;
        font-size: 1rem;
    }

    .security_item {
        padding: 1rem;
        background: var(--bg-light);
        border-radius: 8px;
    }
</style>

