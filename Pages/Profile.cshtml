@page
@model figjam2.Pages.ProfileModel
@{
    ViewData["Title"] = "Profilim";
}

<div class="container-fluid py-4" style="background: #f4f7fe; min-height: 100vh;">
    <div class="container">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-primary">Profil Bilgilerim</h2>
                <p class="text-muted">Kişisel, iş ve finansal durumunuzu buradan yönetebilirsiniz.</p>
            </div>
            <button class="btn btn-primary px-4 py-2 rounded-pill shadow-sm" onclick="toggleEditMode()" id="editBtn">
                <i class="fas fa-edit me-2"></i>Düzenle
            </button>
        </div>

        <div class="row g-4">
            <!-- Sol Kolon: Profil Özeti -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                    <div class="mb-3">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <i class="fas fa-user fa-3x text-primary"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold">@Model.Profile.FullName</h4>
                    <p class="text-muted mb-1">Müşteri ID: @(Model.Profile.CustomerId?.ToString() ?? "---")</p>
                    <p class="badge bg-success-soft text-success rounded-pill px-3">Aktif Kullanıcı</p>
                    <hr class="my-4">
                    <div class="text-start">
                        <div class="mb-3">
                            <label class="small text-muted d-block">TC Kimlik No</label>
                            <span class="fw-semibold">@Model.Profile.MaskedTcKimlikNo</span>
                        </div>
                        <div class="mb-3">
                            <label class="small text-muted d-block">Telefon</label>
                            <span class="fw-semibold">@Model.Profile.Phone</span>
                        </div>
                        <div class="mb-3">
                            <label class="small text-muted d-block">Doğum Tarihi</label>
                            <span class="fw-semibold">@(Model.Profile.BirthDate?.ToString("dd.MM.yyyy") ?? "Belirtilmemiş")</span>
                        </div>
                        <div class="mb-0">
                            <label class="small text-muted d-block">E-posta</label>
                            <span class="fw-semibold text-break">@(string.IsNullOrEmpty(Model.Profile.Email) ? "Belirtilmemiş" : Model.Profile.Email)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sağ Kolon: Detaylı Bilgiler -->
            <div class="col-12 col-lg-8">
                <!-- Adres Bilgileri -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-4 d-flex align-items-center">
                        <i class="fas fa-map-marker-alt text-primary me-2"></i> Adres Bilgileri
                    </h5>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small text-muted">Açık Adres</label>
                            <div class="view-mode fw-semibold p-2 bg-light rounded">@(string.IsNullOrEmpty(Model.Profile.Address) ? "Belirtilmemiş" : Model.Profile.Address)</div>
                            <textarea class="form-control edit-mode d-none" id="input_address" rows="3">@Model.Profile.Address</textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">İl</label>
                            <div class="view-mode fw-semibold p-2 bg-light rounded">@(string.IsNullOrEmpty(Model.Profile.City) ? "Belirtilmemiş" : Model.Profile.City)</div>
                            <input type="text" class="form-control edit-mode d-none" id="input_city" value="@Model.Profile.City" readonly>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">İlçe</label>
                            <div class="view-mode fw-semibold p-2 bg-light rounded">@(string.IsNullOrEmpty(Model.Profile.District) ? "Belirtilmemiş" : Model.Profile.District)</div>
                            <input type="text" class="form-control edit-mode d-none" id="input_district" value="@Model.Profile.District" readonly>
                        </div>
                    </div>
                </div>

                <!-- İş ve Gelir -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-4 d-flex align-items-center">
                        <i class="fas fa-briefcase text-primary me-2"></i> İş ve Gelir Bilgileri
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Meslek</label>
                            <div class="view-mode fw-semibold p-2 bg-light rounded">@(string.IsNullOrEmpty(Model.Profile.Profession) ? "Belirtilmemiş" : Model.Profile.Profession)</div>
                            <input type="text" class="form-control edit-mode d-none" id="input_profession" value="@Model.Profile.Profession">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Gelir Aralığı</label>
                            <div class="view-mode fw-semibold p-2 bg-light rounded">@(string.IsNullOrEmpty(Model.Profile.IncomeRange) ? "Belirtilmemiş" : Model.Profile.IncomeRange)</div>
                            <select class="form-select edit-mode d-none" id="input_incomeRange">
                                <option value="0-20k" selected="@(Model.Profile.IncomeRange == "0-20k")">0 - 20.000 TL</option>
                                <option value="20k-50k" selected="@(Model.Profile.IncomeRange == "20k-50k")">20.000 - 50.000 TL</option>
                                <option value="50k-100k" selected="@(Model.Profile.IncomeRange == "50k-100k")">50.000 - 100.000 TL</option>
                                <option value="100k+" selected="@(Model.Profile.IncomeRange == "100k+")">100.000 TL+</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Finansal Durum & Varlıklar -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-4 d-flex align-items-center">
                        <i class="fas fa-chart-pie text-primary me-2"></i> Finansal Durum ve Varlıklar
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Finansal Durum</label>
                            <div class="view-mode fw-semibold p-2 bg-light rounded">@(string.IsNullOrEmpty(Model.Profile.FinancialStatus) ? "Belirtilmemiş" : Model.Profile.FinancialStatus)</div>
                            <textarea class="form-control edit-mode d-none" id="input_financialStatus" rows="2">@Model.Profile.FinancialStatus</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Varlık Bilgileri</label>
                            <div class="view-mode fw-semibold p-2 bg-light rounded">@(string.IsNullOrEmpty(Model.Profile.AssetInfo) ? "Belirtilmemiş" : Model.Profile.AssetInfo)</div>
                            <textarea class="form-control edit-mode d-none" id="input_assetInfo" rows="2">@Model.Profile.AssetInfo</textarea>
                        </div>
                    </div>
                </div>

                <!-- Eş Bilgileri -->
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-4 d-flex align-items-center">
                        <i class="fas fa-heart text-primary me-2"></i> Eş Bilgileri
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Eş Çalışma Durumu</label>
                            <div class="view-mode fw-semibold p-2 bg-light rounded">@(string.IsNullOrEmpty(Model.Profile.SpouseWorkStatus) ? "Belirtilmemiş" : Model.Profile.SpouseWorkStatus)</div>
                            <div class="edit-mode d-none fw-bold p-2 bg-warning-soft rounded">Bu alan API üzerinden sadece okunabilir.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Eş Gelir Aralığı</label>
                            <div class="view-mode fw-semibold p-2 bg-light rounded">@(string.IsNullOrEmpty(Model.Profile.SpouseIncomeRange) ? "Belirtilmemiş" : Model.Profile.SpouseIncomeRange)</div>
                            <div class="edit-mode d-none fw-bold p-2 bg-warning-soft rounded">Bu alan API üzerinden sadece okunabilir.</div>
                        </div>
                    </div>
                </div>

                <!-- Kaydet Butonu -->
                <div class="edit-mode d-none mt-4 text-end">
                    <button class="btn btn-outline-secondary px-4 py-2 me-2 rounded-pill" onclick="toggleEditMode()">Vazgeç</button>
                    <button class="btn btn-success px-5 py-2 rounded-pill shadow-sm" onclick="saveProfile()">
                        <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-soft { background-color: #e8f5e9; color: #2e7d32; }
    .bg-warning-soft { background-color: #fff3e0; color: #ef6c00; }
    .bg-primary-soft { background-color: #e3f2fd; color: #1565c0; }
    .rounded-4 { border-radius: 1rem !important; }
    .form-control:focus, .form-select:focus { border-color: #2E6DF8; box-shadow: 0 0 0 0.25rem rgba(46, 109, 248, 0.1); }
</style>

<script>
    let isEdit = false;

    function toggleEditMode() {
        isEdit = !isEdit;
        const viewElems = document.querySelectorAll('.view-mode');
        const editElems = document.querySelectorAll('.edit-mode');
        const editBtn = document.getElementById('editBtn');

        if (isEdit) {
            viewElems.forEach(el => el.classList.add('d-none'));
            editElems.forEach(el => el.classList.remove('d-none'));
            editBtn.innerHTML = '<i class="fas fa-eye me-2"></i>Görüntüle';
            editBtn.classList.replace('btn-primary', 'btn-outline-primary');
        } else {
            viewElems.forEach(el => el.classList.remove('d-none'));
            editElems.forEach(el => el.classList.add('d-none'));
            editBtn.innerHTML = '<i class="fas fa-edit me-2"></i>Düzenle';
            editBtn.classList.replace('btn-outline-primary', 'btn-primary');
        }
    }

    async function saveProfile() {
        const data = {
            address: document.getElementById('input_address').value,
            profession: document.getElementById('input_profession').value,
            incomeRange: document.getElementById('input_incomeRange').value,
            financialStatus: document.getElementById('input_financialStatus').value,
            assetInfo: document.getElementById('input_assetInfo').value
        };

        const saveBtn = event.target.closest('button');
        const originalText = saveBtn.innerHTML;
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Kaydediliyor...';

        try {
            const resp = await fetch('/Profile?handler=UpdateProfile', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const res = await resp.json();
            if (res.success) {
                alert('Profil başarıyla güncellendi: ' + res.message);
                window.location.reload();
            } else {
                alert('Hata: ' + res.error);
            }
        } catch (e) {
            alert('Bağlantı hatası oluştu.');
        } finally {
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalText;
        }
    }
</script>
