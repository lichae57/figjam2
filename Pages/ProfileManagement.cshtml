@page
@model figjam2.Pages.ProfileManagementModel
@{
    ViewData["Title"] = "Profil Yönetimi";
}

<div class="profile_management_container">
    <div class="page_header mb-4 fade-in" style="margin-left: 1cm;">
        <h1>
            <i class="fas fa-edit me-2 text-secondary-custom"></i>
            Profil Bilgilerini Güncelle
        </h1>
        <p class="text-muted">Kişisel bilgilerinizi güncelleyebilirsiniz</p>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8 fade-in">
            <div class="card">
                <div class="card-body">
                    <h4 class="mb-4" style="color: #2E6DF8;">
                        <i class="fas fa-map-marker-alt me-2"></i>
                        Adres Bilgileri
                    </h4>
                    <form id="address_form" data-validate="true">
                        @Html.AntiForgeryToken()
                        <div class="form-group mb-3">
                            <label class="form-label" for="address">
                                <i class="fas fa-home me-2"></i>Adres
                            </label>
                            <textarea class="form-control" 
                                      id="address" 
                                      name="address" 
                                      rows="3" 
                                      placeholder="Adres bilginizi giriniz"
                                      required>@(HttpContext.Session.GetString("UserAddress") ?? "Atatürk Mahallesi, Cumhuriyet Caddesi No: 123")</textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label class="form-label" for="city">
                                        <i class="fas fa-city me-2"></i>İl
                                    </label>
                                    <select class="form-control" id="city" name="city" required>
                                        @{
                                            var currentCity = HttpContext.Session.GetString("UserCity") ?? "İstanbul";
                                            var cityLower = currentCity.ToLower();
                                        }
                                        <option value="">Seçiniz</option>
                                        @{
                                            var cities = new[] { "Adana", "Adıyaman", "Afyonkarahisar", "Ağrı", "Amasya", "Ankara", "Antalya", "Artvin", "Aydın", "Balıkesir", "Bilecik", "Bingöl", "Bitlis", "Bolu", "Burdur", "Bursa", "Çanakkale", "Çankırı", "Çorum", "Denizli", "Diyarbakır", "Edirne", "Elazığ", "Erzincan", "Erzurum", "Eskişehir", "Gaziantep", "Giresun", "Gümüşhane", "Hakkari", "Hatay", "Isparta", "Mersin", "İstanbul", "İzmir", "Kars", "Kastamonu", "Kayseri", "Kırklareli", "Kırşehir", "Kocaeli", "Konya", "Kütahya", "Malatya", "Manisa", "Kahramanmaraş", "Mardin", "Muğla", "Muş", "Nevşehir", "Niğde", "Ordu", "Rize", "Sakarya", "Samsun", "Siirt", "Sinop", "Sivas", "Tekirdağ", "Tokat", "Trabzon", "Tunceli", "Şanlıurfa", "Uşak", "Van", "Yozgat", "Zonguldak", "Aksaray", "Bayburt", "Karaman", "Kırıkkale", "Batman", "Şırnak", "Bartın", "Ardahan", "Iğdır", "Yalova", "Karabük", "Kilis", "Osmaniye", "Düzce" };
                                            foreach (var city in cities)
                                            {
                                                var isSelected = cityLower == city.ToLower() || (city == "İstanbul" && string.IsNullOrEmpty(HttpContext.Session.GetString("UserCity")));
                                                <option value="@city" selected="@(isSelected ? "selected" : null)">@city</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label class="form-label" for="district">
                                        <i class="fas fa-map-marked-alt me-2"></i>İlçe
                                    </label>
                                    <input type="text" 
                                           class="form-control" 
                                           id="district" 
                                           name="district"
                                           value="@(HttpContext.Session.GetString("UserDistrict") ?? "Kadıköy")"
                                           required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label class="form-label" for="postal_code">
                                        <i class="fas fa-mail-bulk me-2"></i>Posta Kodu
                                    </label>
                                    <input type="text" 
                                           class="form-control" 
                                           id="postal_code" 
                                           name="postal_code"
                                           value="@(HttpContext.Session.GetString("UserPostalCode") ?? "34700")"
                                           maxlength="5"
                                           pattern="[0-9]{5}"
                                           required>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>
                                Adres Bilgilerini Kaydet
                            </button>
                            <a href="/Profile" class="btn btn-outline">
                                <i class="fas fa-times me-2"></i>
                                İptal
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-body">
                    <h4 class="mb-4" style="color: #2E6DF8;">
                        <i class="fas fa-briefcase me-2"></i>
                        İş Bilgileri
                    </h4>
                    <form id="job_form" data-validate="true">
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-12 col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label" for="profession">
                                        <i class="fas fa-user-tie me-2"></i>Meslek
                                    </label>
                                    <input type="text" 
                                           class="form-control" 
                                           id="profession" 
                                           name="profession"
                                           value="@(HttpContext.Session.GetString("UserJob") ?? "Yazılım Geliştirici")"
                                           required>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label" for="income">
                                        <i class="fas fa-lira-sign me-2"></i>Gelir Aralığı
                                    </label>
                                    <select class="form-control" id="income" name="income" required>
                                        @{
                                            var sessionIncome = HttpContext.Session.GetString("UserIncome");
                                            string currentIncome = "20000-30000"; // Varsayılan değer
                                            
                                            if (!string.IsNullOrEmpty(sessionIncome))
                                            {
                                                var trimmedIncome = sessionIncome.Trim();
                                                
                                                // Geçerli değerlerden biri mi kontrol et
                                                if (trimmedIncome == "0-10000" || 
                                                    trimmedIncome == "10000-20000" || 
                                                    trimmedIncome == "20000-30000" || 
                                                    trimmedIncome == "30000-40000" || 
                                                    trimmedIncome == "40000-50000" || 
                                                    trimmedIncome == "50000+")
                                                {
                                                    currentIncome = trimmedIncome;
                                                }
                                                else
                                                {
                                                    // Eski formatları yeni formata dönüştür
                                                    currentIncome = trimmedIncome switch
                                                    {
                                                        "10000-15000" => "10000-20000",
                                                        "15000-20000" => "10000-20000",
                                                        "20000-25000" => "20000-30000",
                                                        "25000-30000" => "20000-30000",
                                                        "30000+" => "30000-40000",
                                                        _ => trimmedIncome // Bilinmeyen değerleri olduğu gibi kullan
                                                    };
                                                }
                                            }
                                            var incomeOptions = new[]
                                            {
                                                new { Value = "0-10000", Display = "₺0 - ₺10 bin" },
                                                new { Value = "10000-20000", Display = "₺10 - ₺20 bin" },
                                                new { Value = "20000-30000", Display = "₺20 - ₺30 bin" },
                                                new { Value = "30000-40000", Display = "₺30 - ₺40 bin" },
                                                new { Value = "40000-50000", Display = "₺40 - ₺50 bin" },
                                                new { Value = "50000+", Display = "₺50+" }
                                            };
                                            foreach (var option in incomeOptions)
                                            {
                                                var isSelected = currentIncome == option.Value;
                                                <option value="@option.Value" selected="@(isSelected ? "selected" : null)">@option.Display</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>
                                İş Bilgilerini Kaydet
                            </button>
                            <a href="/Profile" class="btn btn-outline">
                                <i class="fas fa-times me-2"></i>
                                İptal
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4 fade-in">
            <div class="card">
                <div class="card-body">
                    <h5 class="mb-4" style="color: #2E6DF8;">
                        <i class="fas fa-info-circle me-2"></i>
                        Bilgilendirme
                    </h5>
                    <div class="alert alert-info mb-3">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <strong>Önemli:</strong> Adres değişiklikleriniz güvenlik kontrolünden geçecektir.
                    </div>
                    <div class="alert alert-warning mb-3">
                        <i class="fas fa-shield-alt me-2"></i>
                        <strong>Güvenlik:</strong> Bilgileriniz şifrelenmiş bağlantı ile korunmaktadır.
                    </div>
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle me-2"></i>
                        <strong>Onay:</strong> Değişiklikleriniz anında geçerli olacaktır.
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="mb-4" style="color: #2E6DF8;">
                        <i class="fas fa-history me-2"></i>
                        Son Değişiklikler
                    </h5>
                    <div class="change_item mb-3">
                        <small class="text-muted">10 Ocak 2025</small>
                        <p class="mb-0"><strong>Adres güncellendi</strong></p>
                    </div>
                    <div class="change_item">
                        <small class="text-muted">5 Ocak 2025</small>
                        <p class="mb-0"><strong>Meslek bilgisi güncellendi</strong></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .profile_management_container {
        padding: 2rem 0;
    }

    .page_header {
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 1rem;
    }


    .change_item {
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .change_item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }
</style>

@section Scripts {
    <script>
        document.getElementById('address_form').addEventListener('submit', function(e) {
            e.preventDefault();
            
            if (validateForm('address_form')) {
                const formData = new FormData();
                formData.append('address', document.getElementById('address').value);
                formData.append('city', document.getElementById('city').value);
                formData.append('district', document.getElementById('district').value);
                formData.append('postalCode', document.getElementById('postal_code').value);

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                formData.append('__RequestVerificationToken', token);

                fetch('/ProfileManagement?handler=UpdateAddress', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showSuccessMessage('Değişiklikler kaydedildi.');
                setTimeout(() => {
                    window.location.href = '/Profile';
                        }, 2000);
                    }
                })
                .catch(error => {
                    showToast('Bir hata oluştu!', 'error');
                });
            }
        });

        document.getElementById('job_form').addEventListener('submit', function(e) {
            e.preventDefault();
            
            if (validateForm('job_form')) {
                const formData = new FormData();
                const incomeValue = document.getElementById('income').value;
                formData.append('profession', document.getElementById('profession').value);
                formData.append('income', incomeValue);
                
                // Debug: income değerini kontrol et
                console.log('Income değeri:', incomeValue);

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                if (token) {
                    formData.append('__RequestVerificationToken', token);
                }

                fetch('/ProfileManagement?handler=UpdateJob', {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Response data:', data);
                    if (data.success) {
                        showSuccessMessage('Değişiklikler kaydedildi.');
                setTimeout(() => {
                    window.location.href = '/Profile';
                        }, 2000);
                    } else {
                        showToast('Bir hata oluştu!', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast('Bir hata oluştu!', 'error');
                });
            }
        });

        // Başarı mesajı göster (ortada yeşil kutucuk)
        function showSuccessMessage(message) {
            // Önceki mesajı kaldır
            const existingMessage = document.getElementById('successMessageBox');
            if (existingMessage) {
                existingMessage.remove();
            }

            // Yeni mesaj kutusu oluştur
            const messageBox = document.createElement('div');
            messageBox.id = 'successMessageBox';
            messageBox.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                background-color: #28a745;
                color: white;
                padding: 1.5rem 2.5rem;
                border-radius: 12px;
                box-shadow: 0 8px 24px rgba(40, 167, 69, 0.3);
                z-index: 10000;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                font-size: 1.1rem;
                font-weight: 500;
                animation: fadeInScale 0.3s ease;
            `;
            messageBox.innerHTML = `
                <i class="fas fa-check-circle" style="font-size: 1.5rem;"></i>
                <span>${message}</span>
            `;

            document.body.appendChild(messageBox);

            // 2 saniye sonra kaldır
            setTimeout(() => {
                messageBox.style.animation = 'fadeOutScale 0.3s ease';
                setTimeout(() => {
                    messageBox.remove();
                }, 300);
            }, 2000);
        }
    </script>

    <style>
        @@keyframes fadeInScale {
            from {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0.8);
            }
            to {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1);
            }
        }

        @@keyframes fadeOutScale {
            from {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1);
            }
            to {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0.8);
            }
        }
    </style>
}

