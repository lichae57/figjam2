@page
@model figjam2.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    var userName = ViewContext.HttpContext.Session.GetString("UserName") ?? "Ahmet Yılmaz";
}

<div class="dashboard-container">
    <div class="container py-4">
        <div class="row g-4">
            <!-- Sol taraf - boş bırakıldı, kullanıcı ekleyecek -->
            <div class="col-12 col-lg-8">
                <!-- Buraya kullanıcı içerik ekleyecek -->
            </div>
            
            <!-- Sağ taraf - Kredi Güven Raporu (Kare) -->
            <div class="col-12 col-lg-4">
                <div class="credit-report-section fade-in">
                    <div class="credit-report-card-square" style="background: white; border: 2px solid #E6F7FF; border-radius: 16px; padding: 2rem; box-shadow: 0 4px 20px rgba(46, 109, 248, 0.1); aspect-ratio: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
                        <h2 class="fw-bold mb-3" style="color: #2E6DF8; font-size: 1.5rem;">
                            <i class="fas fa-shield-alt me-2"></i>
                            Kredi Güven Raporu
                        </h2>
                        <p class="text-muted mb-4" style="font-size: 0.9rem;">Finansal sağlığınızın güvenilir göstergesi</p>
                        
                        <!-- İnteraktif Kredi Skoru Gauge Chart -->
                        <div class="credit-score-gauge-square" style="position: relative; width: 200px; height: 200px; margin: 0 auto 1.5rem;">
                            <svg width="200" height="200" viewBox="0 0 200 200" style="transform: rotate(-90deg);">
                                <circle cx="100" cy="100" r="80" fill="none" stroke="#E6F7FF" stroke-width="12"/>
                                <circle cx="100" cy="100" r="80" fill="none" stroke="#2E6DF8" stroke-width="12" 
                                        stroke-dasharray="@(2 * Math.PI * 80)" 
                                        stroke-dashoffset="@(2 * Math.PI * 80 * (1 - 0.72))" 
                                        stroke-linecap="round" class="gauge-fill"/>
                            </svg>
                            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
                                <div style="font-size: 3rem; font-weight: 800; line-height: 1; color: #2E6DF8;">720</div>
                                <div style="font-size: 0.9rem; color: #6c757d; margin-top: 0.25rem; font-weight: 500;">/ 1000</div>
                            </div>
                        </div>
                        
                        <!-- Motive Edici Geri Bildirim -->
                        <div class="feedback-badge mb-3" style="display: inline-block; background: linear-gradient(135deg, #E6F7FF 0%, #D1ECF1 100%); padding: 0.75rem 1rem; border-radius: 12px; border-left: 4px solid #28a745;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-check-circle" style="color: #28a745; font-size: 1.2rem;"></i>
                                <div>
                                    <div class="fw-bold" style="color: #2E6DF8; font-size: 0.9rem;">Skorun Çok İyi!</div>
                                    <div class="small text-muted" style="font-size: 0.75rem;">Finansal durumunuz güçlü</div>
                                </div>
                            </div>
                        </div>

                        <a href="/CreditReport" class="btn btn-primary-custom" style="background-color: #2E6DF8; color: white; border: none; border-radius: 12px; padding: 0.6rem 1.5rem; font-weight: 600; text-decoration: none; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;">
                            <i class="fas fa-file-alt"></i>
                            Detaylı Rapor Al
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-4">
            <!-- 2. DİVİZYON VE LİMİT YÖNETİMİ -->
            <div class="col-12 col-lg-8">
                <div class="limit-management-section fade-in">
                    <div class="limit-card" style="background: white; border: 2px solid #E6F7FF; border-radius: 16px; padding: 2rem; box-shadow: 0 4px 20px rgba(46, 109, 248, 0.1);">
                        <h3 class="fw-bold mb-4" style="color: #2E6DF8;">
                            <i class="fas fa-wallet me-2"></i>
                            Kullanılabilir Limitlerim
                        </h3>

                        <!-- Kredi Kartı Limiti -->
                        <div class="limit-item mb-4 pb-4" style="border-bottom: 1px solid #E6F7FF;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-credit-card" style="color: #2E6DF8; font-size: 1.2rem;"></i>
                                    <span class="fw-semibold" style="color: #333;">Kredi Kartı Limiti</span>
                                </div>
                                <span class="fw-bold" style="color: #2E6DF8;">₺50.000</span>
                            </div>
                            <div class="progress mb-2" style="height: 12px; border-radius: 12px; background: #E6F7FF;">
                                <div class="progress-bar" style="background: linear-gradient(90deg, #2E6DF8 0%, #0056B3 100%); width: 25%; border-radius: 12px; transition: width 0.6s ease;"></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted small">Kullanılabilir: <strong style="color: #28a745;">₺37.500</strong></span>
                                <span class="text-muted small">Kullanım: <strong style="color: #2E6DF8;">%25</strong></span>
                            </div>
                        </div>

                        <!-- Ek Hesap -->
                        <div class="limit-item mb-4 pb-4" style="border-bottom: 1px solid #E6F7FF;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-plus-circle" style="color: #2E6DF8; font-size: 1.2rem;"></i>
                                    <span class="fw-semibold" style="color: #333;">Ek Hesap</span>
                                </div>
                                <span class="fw-bold" style="color: #2E6DF8;">₺30.000</span>
                            </div>
                            <div class="progress mb-2" style="height: 12px; border-radius: 12px; background: #E6F7FF;">
                                <div class="progress-bar" style="background: linear-gradient(90deg, #2E6DF8 0%, #0056B3 100%); width: 40%; border-radius: 12px; transition: width 0.6s ease;"></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Kullanılabilir: <strong style="color: #28a745;">₺18.000</strong></span>
                                <span class="text-muted small">Kullanım: <strong style="color: #2E6DF8;">%40</strong></span>
                            </div>
                        </div>

                        <!-- Taksitli Nakit Avans -->
                        <div class="limit-item">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-money-bill-wave" style="color: #2E6DF8; font-size: 1.2rem;"></i>
                                    <span class="fw-semibold" style="color: #333;">Taksitli Nakit Avans</span>
                                </div>
                                <span class="fw-bold" style="color: #2E6DF8;">₺25.000</span>
                            </div>
                            <div class="progress mb-2" style="height: 12px; border-radius: 12px; background: #E6F7FF;">
                                <div class="progress-bar" style="background: linear-gradient(90deg, #2E6DF8 0%, #0056B3 100%); width: 15%; border-radius: 12px; transition: width 0.6s ease;"></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Kullanılabilir: <strong style="color: #28a745;">₺21.250</strong></span>
                                <span class="text-muted small">Kullanım: <strong style="color: #2E6DF8;">%15</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. AKSIYON GEÇMİŞİ (Timeline) -->
            <div class="col-12 col-lg-4">
                <div class="action-history-section fade-in">
                    <div class="history-card" style="background: white; border: 2px solid #E6F7FF; border-radius: 16px; padding: 2rem; box-shadow: 0 4px 20px rgba(46, 109, 248, 0.1); height: 100%;">
                        <h3 class="fw-bold mb-4" style="color: #2E6DF8;">
                            <i class="fas fa-history me-2"></i>
                            Son Finansal İşlemleriniz
                        </h3>

                        <div class="timeline" style="max-height: 500px; overflow-y: auto; padding-left: 0;">
                            <!-- Sistem Etkileşimi -->
                            <div class="timeline-item mb-3 pb-3" style="border-left: 3px solid #E6F7FF; padding-left: 1.5rem; position: relative; margin-left: 0;">
                                <div class="timeline-dot" style="position: absolute; left: -8px; top: 0.5rem; width: 14px; height: 14px; background: #2E6DF8; border-radius: 50%; border: 3px solid white; box-shadow: 0 0 0 2px #E6F7FF;"></div>
                                <div class="d-flex align-items-start gap-2">
                                    <i class="fas fa-user-edit" style="color: #2E6DF8; margin-top: 0.25rem; font-size: 1rem;"></i>
                                    <div style="flex: 1;">
                                        <div class="fw-semibold" style="color: #333; font-size: 0.9rem; margin-bottom: 0.25rem;">Hesap Bilgileri Güncellendi</div>
                                        <div class="text-muted" style="font-size: 0.8rem;">14 Ocak 2025, 16:30</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Finansal İşlem -->
                            <div class="timeline-item mb-3 pb-3" style="border-left: 3px solid #E6F7FF; padding-left: 1.5rem; position: relative; margin-left: 0;">
                                <div class="timeline-dot" style="position: absolute; left: -8px; top: 0.5rem; width: 14px; height: 14px; background: #DC3545; border-radius: 50%; border: 3px solid white; box-shadow: 0 0 0 2px #E6F7FF;"></div>
                                <div class="d-flex align-items-start gap-2">
                                    <i class="fas fa-credit-card" style="color: #DC3545; margin-top: 0.25rem; font-size: 1rem;"></i>
                                    <div style="flex: 1;">
                                        <div class="fw-semibold" style="color: #333; font-size: 0.9rem; margin-bottom: 0.25rem;">Kart Harcaması</div>
                                        <div class="text-muted" style="font-size: 0.8rem; margin-bottom: 0.25rem;">12 Ocak 2025, 14:20</div>
                                        <div class="fw-bold text-danger" style="font-size: 0.95rem;">-₺850</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sistem Etkileşimi -->
                            <div class="timeline-item mb-3 pb-3" style="border-left: 3px solid #E6F7FF; padding-left: 1.5rem; position: relative; margin-left: 0;">
                                <div class="timeline-dot" style="position: absolute; left: -8px; top: 0.5rem; width: 14px; height: 14px; background: #28a745; border-radius: 50%; border: 3px solid white; box-shadow: 0 0 0 2px #E6F7FF;"></div>
                                <div class="d-flex align-items-start gap-2">
                                    <i class="fas fa-chart-line" style="color: #28a745; margin-top: 0.25rem; font-size: 1rem;"></i>
                                    <div style="flex: 1;">
                                        <div class="fw-semibold" style="color: #333; font-size: 0.9rem; margin-bottom: 0.25rem;">Yeni Limit Tanımlandı</div>
                                        <div class="text-muted" style="font-size: 0.8rem;">10 Ocak 2025, 10:15</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Finansal İşlem -->
                            <div class="timeline-item mb-3 pb-3" style="border-left: 3px solid #E6F7FF; padding-left: 1.5rem; position: relative; margin-left: 0;">
                                <div class="timeline-dot" style="position: absolute; left: -8px; top: 0.5rem; width: 14px; height: 14px; background: #DC3545; border-radius: 50%; border: 3px solid white; box-shadow: 0 0 0 2px #E6F7FF;"></div>
                                <div class="d-flex align-items-start gap-2">
                                    <i class="fas fa-file-invoice-dollar" style="color: #DC3545; margin-top: 0.25rem; font-size: 1rem;"></i>
                                    <div style="flex: 1;">
                                        <div class="fw-semibold" style="color: #333; font-size: 0.9rem; margin-bottom: 0.25rem;">Kredi Ödemesi</div>
                                        <div class="text-muted" style="font-size: 0.8rem; margin-bottom: 0.25rem;">8 Ocak 2025, 09:00</div>
                                        <div class="fw-bold text-danger" style="font-size: 0.95rem;">-₺2.500</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Finansal İşlem -->
                            <div class="timeline-item mb-3 pb-3" style="border-left: 3px solid #E6F7FF; padding-left: 1.5rem; position: relative; margin-left: 0;">
                                <div class="timeline-dot" style="position: absolute; left: -8px; top: 0.5rem; width: 14px; height: 14px; background: #28a745; border-radius: 50%; border: 3px solid white; box-shadow: 0 0 0 2px #E6F7FF;"></div>
                                <div class="d-flex align-items-start gap-2">
                                    <i class="fas fa-exchange-alt" style="color: #28a745; margin-top: 0.25rem; font-size: 1rem;"></i>
                                    <div style="flex: 1;">
                                        <div class="fw-semibold" style="color: #333; font-size: 0.9rem; margin-bottom: 0.25rem;">Para Transferi</div>
                                        <div class="text-muted" style="font-size: 0.8rem; margin-bottom: 0.25rem;">5 Ocak 2025, 11:45</div>
                                        <div class="fw-bold text-success" style="font-size: 0.95rem;">+₺5.000</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. HIZLI ERİŞİM VE HİZMETLER -->
        <div class="quick-access-section mt-5 fade-in">
            <div class="d-flex justify-content-end">
                <a href="/Services" class="btn btn-sm" style="background-color: #E6F7FF; color: #2E6DF8; border: 1px solid #2E6DF8; border-radius: 12px; padding: 0.5rem 1.5rem; font-weight: 600; text-decoration: none; transition: all 0.3s ease;">
                    <i class="fas fa-bolt me-2"></i>
                    Hızlı Erişim ve Hizmetler
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        padding: 2rem 0;
        background: linear-gradient(180deg, #F5F7FA 0%, #FFFFFF 100%);
        min-height: calc(100vh - 200px);
    }

    /* Animasyonlar */
    .fade-in {
        animation: fadeInUp 0.6s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Kredi Güven Raporu Kartı */
    .credit-report-card {
        transition: all 0.3s ease;
    }

    .credit-report-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(46, 109, 248, 0.15) !important;
    }

    /* Kredi Güven Raporu Kare Kartı */
    .credit-report-card-square {
        transition: all 0.3s ease;
    }

    .credit-report-card-square:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(46, 109, 248, 0.15) !important;
    }

    .gauge-fill {
        transition: stroke-dashoffset 1s ease-out;
    }

    /* Limit Yönetimi */
    .limit-card {
        transition: all 0.3s ease;
    }

    .limit-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(46, 109, 248, 0.12) !important;
    }

    .btn-outline-primary-custom:hover {
        background-color: #2E6DF8 !important;
        color: white !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(46, 109, 248, 0.2);
    }

    .btn-outline-primary-custom:active {
        transform: translateY(0);
        box-shadow: 0 2px 6px rgba(46, 109, 248, 0.15);
    }

    /* Aksiyon Geçmişi */
    .history-card {
        transition: all 0.3s ease;
    }

    .history-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(46, 109, 248, 0.12) !important;
    }

    .timeline::-webkit-scrollbar {
        width: 6px;
    }

    .timeline::-webkit-scrollbar-track {
        background: #F5F7FA;
        border-radius: 10px;
    }

    .timeline::-webkit-scrollbar-thumb {
        background: #E6F7FF;
        border-radius: 10px;
    }

    .timeline::-webkit-scrollbar-thumb:hover {
        background: #2E6DF8;
    }

    /* Hızlı Erişim Kartları */
    .service-card {
        cursor: pointer;
    }

    .service-card:hover {
        transform: translateY(-8px);
        border-color: #2E6DF8 !important;
        box-shadow: 0 8px 25px rgba(46, 109, 248, 0.15) !important;
    }

    .service-card:hover .service-icon {
        transform: scale(1.1);
        background: linear-gradient(135deg, #2E6DF8 0%, #0056B3 100%) !important;
    }

    .service-card:hover .service-icon i {
        color: white !important;
    }

    .service-icon {
        transition: all 0.3s ease;
    }

    /* Buton Hover Efektleri */
    .btn-primary-custom:hover {
        background-color: #0056B3 !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(46, 109, 248, 0.3);
    }

    .btn-primary-custom:active {
        transform: translateY(0);
        box-shadow: 0 2px 8px rgba(46, 109, 248, 0.2);
    }

    /* Disabled State */
    .btn:disabled,
    .btn.disabled {
        opacity: 0.6;
        cursor: not-allowed;
        pointer-events: none;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .credit-report-card {
            padding: 2rem !important;
        }

        .credit-score-gauge {
            width: 220px !important;
            height: 220px !important;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 1rem 0;
        }

        .credit-report-card,
        .limit-card,
        .history-card {
            padding: 1.5rem !important;
        }

        .credit-score-gauge {
            width: 200px !important;
            height: 200px !important;
        }
    }
</style>
