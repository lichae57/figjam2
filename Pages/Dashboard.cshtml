@page
@model figjam2.Pages.DashboardModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="dashboard-container">
    <!-- Özel Fırsatlar Carousel -->
    <div class="opportunities-carousel mb-4 fade-in">
        <div id="opportunitiesCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#opportunitiesCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#opportunitiesCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#opportunitiesCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner rounded-4" style="overflow: hidden; box-shadow: var(--shadow-lg);">
                <!-- Slide 1 -->
                <div class="carousel-item active">
                    <div class="row g-0">
                        <div class="col-md-6">
                            <div class="carousel-image-container" style="height: 550px; background: linear-gradient(135deg, #2E6DF8 0%, #0056B3 100%); display: flex; align-items: center; justify-content: center; position: relative;">
                                <div class="person-placeholder" style="width: 200px; height: 300px; background: rgba(255,255,255,0.2); border-radius: 20px; position: relative; overflow: hidden;">
                                    <div style="position: absolute; top: 20%; left: 50%; transform: translateX(-50%); width: 80px; height: 80px; background: rgba(255,255,255,0.3); border-radius: 50%;"></div>
                                    <div style="position: absolute; top: 45%; left: 50%; transform: translateX(-50%); width: 120px; height: 150px; background: rgba(255,255,255,0.25); border-radius: 10px;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-center" style="background: white; padding: 3rem;">
                            <div>
                                <h2 class="mb-3" style="color: var(--primary-color); font-weight: 700;">
                                    <i class="fas fa-percent me-2 text-secondary-custom"></i>
                                    Özel Kredi Fırsatları
                                </h2>
                                <p class="lead mb-4" style="color: var(--text-secondary); line-height: 1.8;">
                                    Size özel hazırladığımız kredi fırsatları ile hayallerinizi gerçekleştirin. Düşük faiz oranları ve esnek ödeme seçenekleri sizi bekliyor.
                                </p>
                                <a href="/CreditCalculator" class="btn btn-primary-custom text-white px-4 py-3 fw-semibold" style="background-color: var(--secondary-color); border: none; border-radius: 8px;">
                                    Hemen Başvur <i class="fas fa-arrow-right ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Slide 2 -->
                <div class="carousel-item">
                    <div class="row g-0">
                        <div class="col-md-6">
                            <div class="carousel-image-container" style="height: 550px; background: linear-gradient(135deg, #0056B3 0%, #222854 100%); display: flex; align-items: center; justify-content: center; position: relative;">
                                <div class="person-placeholder" style="width: 200px; height: 300px; background: rgba(255,255,255,0.2); border-radius: 20px; position: relative; overflow: hidden;">
                                    <div style="position: absolute; top: 20%; left: 50%; transform: translateX(-50%); width: 80px; height: 80px; background: rgba(255,255,255,0.3); border-radius: 50%;"></div>
                                    <div style="position: absolute; top: 45%; left: 50%; transform: translateX(-50%); width: 120px; height: 150px; background: rgba(255,255,255,0.25); border-radius: 10px;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-center" style="background: white; padding: 3rem;">
                            <div>
                                <h2 class="mb-3" style="color: var(--primary-color); font-weight: 700;">
                                    <i class="fas fa-piggy-bank me-2 text-secondary-custom"></i>
                                    Tasarruf Hesapları
                                </h2>
                                <p class="lead mb-4" style="color: var(--text-secondary); line-height: 1.8;">
                                    Paranızı değerlendirin! Yüksek faiz oranlı tasarruf hesaplarımız ile geleceğinize yatırım yapın. Güvenli ve karlı birikim seçenekleri.
                                </p>
                                <a href="/Services" class="btn btn-primary-custom text-white px-4 py-3 fw-semibold" style="background-color: var(--secondary-color); border: none; border-radius: 8px;">
                                    Detayları Gör <i class="fas fa-arrow-right ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Slide 3 -->
                <div class="carousel-item">
                    <div class="row g-0">
                        <div class="col-md-6">
                            <div class="carousel-image-container" style="height: 550px; background: linear-gradient(135deg, #222854 0%, #2E6DF8 100%); display: flex; align-items: center; justify-content: center; position: relative;">
                                <div class="person-placeholder" style="width: 200px; height: 300px; background: rgba(255,255,255,0.2); border-radius: 20px; position: relative; overflow: hidden;">
                                    <div style="position: absolute; top: 20%; left: 50%; transform: translateX(-50%); width: 80px; height: 80px; background: rgba(255,255,255,0.3); border-radius: 50%;"></div>
                                    <div style="position: absolute; top: 45%; left: 50%; transform: translateX(-50%); width: 120px; height: 150px; background: rgba(255,255,255,0.25); border-radius: 10px;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-center" style="background: white; padding: 3rem;">
                            <div>
                                <h2 class="mb-3" style="color: var(--primary-color); font-weight: 700;">
                                    <i class="fas fa-credit-card me-2 text-secondary-custom"></i>
                                    Kredi Kartı Avantajları
                                </h2>
                                <p class="lead mb-4" style="color: var(--text-secondary); line-height: 1.8;">
                                    Nakit geri ödeme, puan kazanma ve özel indirimler! Kredi kartlarımız ile alışverişlerinizden daha fazla kazanın.
                                </p>
                                <a href="/Services" class="btn btn-primary-custom text-white px-4 py-3 fw-semibold" style="background-color: var(--secondary-color); border: none; border-radius: 8px;">
                                    Keşfet <i class="fas fa-arrow-right ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#opportunitiesCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Önceki</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#opportunitiesCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Sonraki</span>
            </button>
        </div>
    </div>

    <!-- Hizmetler ve Özellikler Bölümü -->
    <div class="services-section mt-5 fade-in" style="margin-top: 5rem !important;">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="fw-bold mb-3" style="color: var(--primary-color);">
                    Size Özel Hizmetlerimiz
                </h2>
                <p class="lead text-muted">İhtiyaçlarınıza uygun finansal çözümler</p>
            </div>

            <div class="row g-4 mb-5">
                <!-- Kredi Hizmetleri -->
                <div class="col-lg-3 col-md-6">
                    <div class="service-card card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="service-icon mb-3" style="width: 80px; height: 80px; margin: 0 auto; background: linear-gradient(135deg, var(--secondary-color), var(--accent-color)); border-radius: 20px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-hand-holding-usd fa-3x text-white"></i>
                            </div>
                            <h5 class="fw-bold mb-3" style="color: var(--primary-color);">Kredi Çözümleri</h5>
                            <p class="text-muted mb-4">İhtiyaç, konut, taşıt kredisi ve daha fazlası</p>
                            <a href="/CreditCalculator" class="btn btn-sm" style="background-color: var(--secondary-color); color: white; border: none;">
                                Detaylar <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Tasarruf Hesapları -->
                <div class="col-lg-3 col-md-6">
                    <div class="service-card card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="service-icon mb-3" style="width: 80px; height: 80px; margin: 0 auto; background: linear-gradient(135deg, var(--accent-color), var(--primary-color)); border-radius: 20px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-piggy-bank fa-3x text-white"></i>
                            </div>
                            <h5 class="fw-bold mb-3" style="color: var(--primary-color);">Tasarruf Hesapları</h5>
                            <p class="text-muted mb-4">Paranızı güvenle değerlendirin</p>
                            <a href="/Services" class="btn btn-sm" style="background-color: var(--secondary-color); color: white; border: none;">
                                Detaylar <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Yatırım Ürünleri -->
                <div class="col-lg-3 col-md-6">
                    <div class="service-card card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="service-icon mb-3" style="width: 80px; height: 80px; margin: 0 auto; background: linear-gradient(135deg, var(--secondary-color), var(--accent-color)); border-radius: 20px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-chart-line fa-3x text-white"></i>
                            </div>
                            <h5 class="fw-bold mb-3" style="color: var(--primary-color);">Yatırım Ürünleri</h5>
                            <p class="text-muted mb-4">Geleceğinize yatırım yapın</p>
                            <a href="/Services" class="btn btn-sm" style="background-color: var(--secondary-color); color: white; border: none;">
                                Detaylar <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Dijital Bankacılık -->
                <div class="col-lg-3 col-md-6">
                    <div class="service-card card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="service-icon mb-3" style="width: 80px; height: 80px; margin: 0 auto; background: linear-gradient(135deg, var(--accent-color), var(--primary-color)); border-radius: 20px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-mobile-alt fa-3x text-white"></i>
                            </div>
                            <h5 class="fw-bold mb-3" style="color: var(--primary-color);">Dijital Bankacılık</h5>
                            <p class="text-muted mb-4">7/24 bankacılık hizmetleri</p>
                            <a href="/Services" class="btn btn-sm" style="background-color: var(--secondary-color); color: white; border: none;">
                                Detaylar <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Özellikler Bölümü -->
            <div class="features-section bg-light rounded-4 p-5 mt-5">
                <div class="row g-4 align-items-center">
                    <div class="col-lg-6">
                        <h3 class="fw-bold mb-4" style="color: var(--primary-color);">
                            Neden İnteraktif Kredi?
                        </h3>
                        <div class="feature-list">
                            <div class="feature-item d-flex mb-4">
                                <div class="feature-icon me-3" style="width: 50px; height: 50px; background: var(--secondary-color); border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <i class="fas fa-shield-alt text-white"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1" style="color: var(--primary-color);">Güvenli İşlemler</h6>
                                    <p class="text-muted mb-0">256-bit SSL şifreleme ile güvenli bankacılık</p>
                                </div>
                            </div>
                            <div class="feature-item d-flex mb-4">
                                <div class="feature-icon me-3" style="width: 50px; height: 50px; background: var(--secondary-color); border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <i class="fas fa-clock text-white"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1" style="color: var(--primary-color);">7/24 Hizmet</h6>
                                    <p class="text-muted mb-0">İstediğiniz zaman, istediğiniz yerden işlem yapın</p>
                                </div>
                            </div>
                            <div class="feature-item d-flex">
                                <div class="feature-icon me-3" style="width: 50px; height: 50px; background: var(--secondary-color); border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <i class="fas fa-headset text-white"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1" style="color: var(--primary-color);">Müşteri Desteği</h6>
                                    <p class="text-muted mb-0">Uzman ekibimiz size yardımcı olmaya hazır</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="stats-grid">
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="stat-card bg-white rounded-3 p-4 text-center shadow-sm">
                                        <h2 class="fw-bold mb-2" style="color: var(--secondary-color);">2M+</h2>
                                        <p class="text-muted mb-0 small">Aktif Müşteri</p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="stat-card bg-white rounded-3 p-4 text-center shadow-sm">
                                        <h2 class="fw-bold mb-2" style="color: var(--secondary-color);">₺50B+</h2>
                                        <p class="text-muted mb-0 small">Kredi Portföyü</p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="stat-card bg-white rounded-3 p-4 text-center shadow-sm">
                                        <h2 class="fw-bold mb-2" style="color: var(--secondary-color);">500+</h2>
                                        <p class="text-muted mb-0 small">Şube</p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="stat-card bg-white rounded-3 p-4 text-center shadow-sm">
                                        <h2 class="fw-bold mb-2" style="color: var(--secondary-color);">%99.9</h2>
                                        <p class="text-muted mb-0 small">Memnuniyet</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        padding: 2rem 0;
    }

    .welcome-section .card {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        border: none;
    }

    .balance-display {
        background: rgba(255, 255, 255, 0.1);
        padding: 1rem 1.5rem;
        border-radius: 8px;
        display: inline-block;
    }

    /* Opportunities Carousel Styles */
    .opportunities-carousel .carousel-item {
        transition: transform 0.6s ease-in-out;
    }

    .opportunities-carousel .carousel-control-prev,
    .opportunities-carousel .carousel-control-next {
        width: 50px;
        height: 50px;
        background-color: rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0.8;
        transition: all 0.3s ease;
    }

    .opportunities-carousel .carousel-control-prev {
        left: 20px;
    }

    .opportunities-carousel .carousel-control-next {
        right: 20px;
    }

    .opportunities-carousel .carousel-control-prev:hover,
    .opportunities-carousel .carousel-control-next:hover {
        opacity: 1;
        background-color: var(--secondary-color);
    }

    .opportunities-carousel .carousel-control-prev-icon,
    .opportunities-carousel .carousel-control-next-icon {
        filter: invert(1);
        width: 20px;
        height: 20px;
    }

    .opportunities-carousel .carousel-indicators {
        bottom: 20px;
    }

    .opportunities-carousel .carousel-indicators button {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.5);
        border: 2px solid white;
    }

    .opportunities-carousel .carousel-indicators button.active {
        background-color: var(--secondary-color);
    }

    .opportunities-carousel .person-placeholder {
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
    }

    @@media (max-width: 768px) {
        .opportunities-carousel .carousel-image-container {
            height: 300px !important;
        }
        
        .opportunities-carousel .col-md-6.d-flex {
            padding: 2rem 1.5rem !important;
        }
        
        .opportunities-carousel .person-placeholder {
            width: 150px !important;
            height: 200px !important;
        }
    }

    /* Service Cards Styles */
    .service-card {
        transition: all 0.3s ease;
        border-radius: 16px;
    }

    .service-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-lg) !important;
    }

    .service-icon {
        transition: transform 0.3s ease;
    }

    .service-card:hover .service-icon {
        transform: scale(1.1);
    }

    .feature-item {
        transition: transform 0.2s ease;
    }

    .feature-item:hover {
        transform: translateX(5px);
    }

    .stat-card {
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-md) !important;
    }
</style>


