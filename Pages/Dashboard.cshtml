<style>
    .dashboard-container {
        padding: 1.5rem 0;
        background: linear-gradient(180deg, #F5F7FA 0%, #FFFFFF 100%);
        min-height: calc(100vh - 200px);
    }

    /* Animasyonlar */
    .fade-in {
        animation: fadeInUp 0.6s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Kredi Güven Raporu Kartı */
    .credit-report-card {
        transition: all 0.3s ease;
    }

    .credit-report-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(46, 109, 248, 0.15) !important;
    }

    /* Kredi Güven Raporu Kare Kartı */
    .credit-report-card-square {
        transition: all 0.3s ease;
    }

    .credit-report-card-square:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(46, 109, 248, 0.15) !important;
    }

    .gauge-fill {
        transition: stroke-dashoffset 1s ease-out;
    }

    /* Limit Yönetimi */
    .limit-card {
        transition: all 0.3s ease;
    }

    .limit-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(46, 109, 248, 0.12) !important;
    }

    .btn-outline-primary-custom:hover {
        background-color: #2E6DF8 !important;
        color: white !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(46, 109, 248, 0.2);
    }

    .btn-outline-primary-custom:active {
        transform: translateY(0);
        box-shadow: 0 2px 6px rgba(46, 109, 248, 0.15);
    }

    /* Aksiyon Geçmişi */
    .history-card {
        transition: all 0.3s ease;
    }

    .history-card:hover {
        transform: translateY(-3px);
