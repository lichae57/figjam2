@page
@model figjam2.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    var userName = ViewContext.HttpContext.Session.GetString("UserName") ?? "Ahmet Yılmaz";
}

<div class="dashboard-container">
    <!-- Karşılama ve Kredi Skoru Bölümü -->
    <div class="welcome-section mb-5 fade-in" style="background: linear-gradient(135deg, #2E6DF8 0%, #0056B3 100%); border-radius: 20px; padding: 3rem; color: white; margin-bottom: 2rem; box-shadow: 0 10px 30px rgba(46, 109, 248, 0.2);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h1 class="display-5 fw-bold mb-3">Hoş geldin, @userName</h1>
                    <p class="lead mb-4" style="opacity: 0.9;">Finansal özetin aşağıda</p>
                </div>
                <div class="col-md-6 text-center">
                    <div class="credit-score-gauge" style="position: relative; width: 250px; height: 250px; margin: 0 auto;">
                        <svg width="250" height="250" viewBox="0 0 250 250" style="transform: rotate(-90deg);">
                            <circle cx="125" cy="125" r="100" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="15"/>
                            <circle cx="125" cy="125" r="100" fill="none" stroke="white" stroke-width="15" 
                                    stroke-dasharray="@(2 * Math.PI * 100)" 
                                    stroke-dashoffset="@(2 * Math.PI * 100 * (1 - 0.72))" 
                                    stroke-linecap="round"/>
                        </svg>
                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
                            <div style="font-size: 3.5rem; font-weight: 800; line-height: 1;">720</div>
                            <div style="font-size: 1.1rem; opacity: 0.9; margin-top: 0.5rem;">İnteraktif Kredi Skoru</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Finansal Özet Kartları -->
    <div class="financial-summary mb-5 fade-in">
        <div class="container">
            <div class="row g-4">
                <!-- Aktif Borçlarım -->
                <div class="col-md-4">
                    <div class="summary-card" style="background: white; border: 2px solid #E6F7FF; border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05); transition: all 0.3s ease;">
                        <div class="d-flex align-items-center mb-3">
                            <div style="width: 50px; height: 50px; background: #E6F7FF; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 1rem;">
                                <i class="fas fa-file-invoice-dollar" style="font-size: 1.5rem; color: #2E6DF8;"></i>
                            </div>
                            <h5 class="fw-bold mb-0" style="color: #2E6DF8;">Aktif Borçlarım</h5>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">İhtiyaç Kredisi</span>
                                <span class="fw-bold" style="color: #2E6DF8;">₺45.000</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Kredi Kartı</span>
                                <span class="fw-bold" style="color: #2E6DF8;">₺12.500</span>
                            </div>
                            <hr class="my-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Toplam</span>
                                <span class="fw-bold fs-5" style="color: #2E6DF8;">₺57.500</span>
                            </div>
                        </div>
                        <a href="/CreditReport" class="btn btn-sm w-100" style="background-color: #2E6DF8; color: white; border: none; border-radius: 12px; padding: 0.5rem; text-decoration: none; transition: all 0.3s ease;">
                            Detayları Gör <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>

                <!-- Limitlerim -->
                <div class="col-md-4">
                    <div class="summary-card" style="background: white; border: 2px solid #E6F7FF; border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05); transition: all 0.3s ease;">
                        <div class="d-flex align-items-center mb-3">
                            <div style="width: 50px; height: 50px; background: #E6F7FF; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 1rem;">
                                <i class="fas fa-credit-card" style="font-size: 1.5rem; color: #2E6DF8;"></i>
                            </div>
                            <h5 class="fw-bold mb-0" style="color: #2E6DF8;">Limitlerim</h5>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Kredi Kartı Limiti</span>
                                <span class="fw-bold" style="color: #2E6DF8;">₺50.000</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Kullanılabilir Limit</span>
                                <span class="fw-bold" style="color: #28a745;">₺37.500</span>
                            </div>
                            <div class="progress mb-2" style="height: 8px; border-radius: 10px; background: #E6F7FF;">
                                <div class="progress-bar" style="background: #2E6DF8; width: 25%; border-radius: 10px;"></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Kullanım Oranı</span>
                                <span class="fw-bold small" style="color: #2E6DF8;">%25</span>
                            </div>
                        </div>
                        <a href="/CreditApplication" class="btn btn-sm w-100" style="background-color: #2E6DF8; color: white; border: none; border-radius: 12px; padding: 0.5rem; text-decoration: none; transition: all 0.3s ease;">
                            Limit Artır <i class="fas fa-arrow-up ms-2"></i>
                        </a>
                    </div>
                </div>

                <!-- Son İşlemler -->
                <div class="col-md-4">
                    <div class="summary-card" style="background: white; border: 2px solid #E6F7FF; border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05); transition: all 0.3s ease;">
                        <div class="d-flex align-items-center mb-3">
                            <div style="width: 50px; height: 50px; background: #E6F7FF; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 1rem;">
                                <i class="fas fa-history" style="font-size: 1.5rem; color: #2E6DF8;"></i>
                            </div>
                            <h5 class="fw-bold mb-0" style="color: #2E6DF8;">Son İşlemler</h5>
                        </div>
                        <div class="mb-3" style="max-height: 200px; overflow-y: auto;">
                            <div class="d-flex justify-content-between align-items-center mb-3 pb-3" style="border-bottom: 1px solid #E6F7FF;">
                                <div>
                                    <div class="fw-bold small" style="color: #333;">Kredi Ödemesi</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">15 Ocak 2025</div>
                                </div>
                                <span class="fw-bold text-danger">-₺2.500</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3 pb-3" style="border-bottom: 1px solid #E6F7FF;">
                                <div>
                                    <div class="fw-bold small" style="color: #333;">Kart Harcaması</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">12 Ocak 2025</div>
                                </div>
                                <span class="fw-bold text-danger">-₺850</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold small" style="color: #333;">Para Transferi</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">10 Ocak 2025</div>
                                </div>
                                <span class="fw-bold text-success">+₺5.000</span>
                            </div>
                        </div>
                        <a href="/AccountOperations" class="btn btn-sm w-100" style="background-color: #2E6DF8; color: white; border: none; border-radius: 12px; padding: 0.5rem; text-decoration: none; transition: all 0.3s ease;">
                            Tümünü Gör <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        padding: 2rem 0;
        background-color: var(--bg-light);
        min-height: calc(100vh - 200px);
    }

    .welcome-section {
        animation: fadeInUp 0.6s ease-out;
    }

    .financial-summary {
        animation: fadeInUp 0.8s ease-out;
    }

    .summary-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(46, 109, 248, 0.15) !important;
        border-color: #2E6DF8 !important;
    }

    .summary-card a:hover {
        background-color: #0056B3 !important;
        transform: scale(1.02);
    }

    .credit-score-gauge {
        animation: scaleIn 0.8s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes scaleIn {
        from {
            opacity: 0;
            transform: scale(0.8);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .fade-in {
        animation: fadeIn 0.6s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @@media (max-width: 768px) {
        .welcome-section {
            padding: 2rem 1rem !important;
        }

        .credit-score-gauge {
            width: 200px !important;
            height: 200px !important;
        }

        .summary-card {
            margin-bottom: 1.5rem;
        }
    }
</style>
