                        <div class="credit-score-gauge-square" style="position: relative; width: 200px; height: 200px; margin: 0 auto 1.5rem;">
                            <svg width="200" height="200" viewBox="0 0 200 200" style="transform: rotate(-90deg);">
                                <circle cx="100" cy="100" r="80" fill="none" stroke="#E6F7FF" stroke-width="12"/>
                                <circle cx="100" cy="100" r="80" fill="none" stroke="#2E6DF8" stroke-width="12" 
                                        stroke-dasharray="@(2 * Math.PI * 80)" 
                                        stroke-dashoffset="@(2 * Math.PI * 80 * (1 - 0.72))" 
                                        stroke-linecap="round" class="gauge-fill"/>
                            </svg>
                            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
                                <div style="font-size: 3rem; font-weight: 800; line-height: 1; color: #2E6DF8;">720</div>
                                <div style="font-size: 0.9rem; color: #6c757d; margin-top: 0.25rem; font-weight: 500;">/ 1000</div>
                            </div>
                        </div>
                        
