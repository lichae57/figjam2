@page
@model figjam2.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    var userName = ViewContext.HttpContext.Session.GetString("UserName") ?? "Ahmet Yılmaz";
}

<div class="dashboard-container">
    <div class="container py-3">
        <div class="row g-4 align-items-stretch">
            <!-- Kullanılabilir Limitlerim - Yukarı Taşındı -->
            <div class="col-12 col-lg-8">
                <div class="limit-management-section fade-in h-100">
                    <div class="limit-card h-100" style="background: white; border: 2px solid #E6F7FF; border-radius: 16px; padding: 2rem; box-shadow: 0 4px 20px rgba(46, 109, 248, 0.1); display: flex; flex-direction: column;">
                        <h3 class="fw-bold mb-4" style="color: #2E6DF8;">
                            <i class="fas fa-wallet me-2"></i>
                            Kullanılabilir Limitlerim
                        </h3>

                        <!-- Kredi Kartı Limiti -->
                        <div class="limit-item mb-4 pb-4" style="border-bottom: 1px solid #E6F7FF;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-credit-card" style="color: #2E6DF8; font-size: 1.2rem;"></i>
                                    <span class="fw-semibold" style="color: #333;">Kredi Kartı Limiti</span>
                                </div>
                                <span class="fw-bold" style="color: #2E6DF8;">₺50.000</span>
                            </div>
                            <div class="progress mb-2" style="height: 12px; border-radius: 12px; background: #E6F7FF;">
                                <div class="progress-bar" style="background: linear-gradient(90deg, #2E6DF8 0%, #0056B3 100%); width: 25%; border-radius: 12px; transition: width 0.6s ease;"></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted small">Kullanılabilir: <strong style="color: #28a745;">₺37.500</strong></span>
                                <span class="text-muted small">Kullanım: <strong style="color: #2E6DF8;">%25</strong></span>
                            </div>
                        </div>

                        <!-- Ek Hesap -->
                        <div class="limit-item mb-4 pb-4" style="border-bottom: 1px solid #E6F7FF;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-plus-circle" style="color: #2E6DF8; font-size: 1.2rem;"></i>
                                    <span class="fw-semibold" style="color: #333;">Ek Hesap</span>
                                </div>
                                <span class="fw-bold" style="color: #2E6DF8;">₺30.000</span>
                            </div>
                            <div class="progress mb-2" style="height: 12px; border-radius: 12px; background: #E6F7FF;">
                                <div class="progress-bar" style="background: linear-gradient(90deg, #2E6DF8 0%, #0056B3 100%); width: 40%; border-radius: 12px; transition: width 0.6s ease;"></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Kullanılabilir: <strong style="color: #28a745;">₺18.000</strong></span>
                                <span class="text-muted small">Kullanım: <strong style="color: #2E6DF8;">%40</strong></span>
                            </div>
                        </div>

                        <!-- Taksitli Nakit Avans -->
