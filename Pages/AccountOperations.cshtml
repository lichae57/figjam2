@page "/AccountOperations"
@model figjam2.Pages.AccountOperationsModel
@{
    ViewData["Title"] = "Hesap İşlemleri";
}

<div class="service-detail-container">
    <div class="page-header mb-5 fade-in">
        <div class="d-flex align-items-center mb-3">
            <div class="service-header-icon me-3">
                <i class="fas fa-landmark"></i>
            </div>
            <div>
                <h1 class="mb-2">Hesap İşlemleri</h1>
                <p class="text-muted mb-0">Hesap bakiyenizi görüntüleyin, para transferi yapın ve hesap ekstrelerinize erişin</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Hesap Bakiyesi -->
        <div class="col-12 col-lg-4 fade-in">
            <div class="card h-100 feature-card">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-wallet"></i>
                    </div>
                    <h4 class="mb-3">Hesap Bakiyesi</h4>
                    <p class="text-muted mb-4">Tüm hesaplarınızın güncel bakiyelerini görüntüleyin ve detaylı bilgilere erişin.</p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Anlık bakiye sorgulama</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Hesap özeti görüntüleme</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Çoklu hesap yönetimi</li>
                    </ul>
                    <a href="/Dashboard" class="btn btn-primary w-100">
                        <i class="fas fa-eye me-2"></i>Bakiyeyi Görüntüle
                    </a>
                </div>
            </div>
        </div>

        <!-- Para Transferi -->
        <div class="col-12 col-lg-4 fade-in">
            <div class="card h-100 feature-card">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-exchange-alt"></i>
                    </div>
                    <h4 class="mb-3">Para Transferi</h4>
                    <p class="text-muted mb-4">Hızlı ve güvenli para transferi işlemlerinizi gerçekleştirin.</p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Havale/EFT işlemleri</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Anında transfer</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Favori hesaplar</li>
                    </ul>
                    <a href="/Dashboard" class="btn btn-primary w-100">
                        <i class="fas fa-paper-plane me-2"></i>Transfer Yap
                    </a>
                </div>
            </div>
        </div>

        <!-- Hesap Ekstreleri -->
        <div class="col-12 col-lg-4 fade-in">
            <div class="card h-100 feature-card">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-file-invoice"></i>
                    </div>
                    <h4 class="mb-3">Hesap Ekstreleri</h4>
                    <p class="text-muted mb-4">Hesap hareketlerinizi görüntüleyin ve ekstrelerinizi indirin.</p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Detaylı işlem geçmişi</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>PDF ekstre indirme</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Filtreleme ve arama</li>
                    </ul>
                    <a href="/Dashboard" class="btn btn-primary w-100">
                        <i class="fas fa-download me-2"></i>Ekstre İndir
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Özellikler -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-body p-5">
                    <h3 class="mb-4 text-center">
                        <i class="fas fa-star me-2 text-secondary-custom"></i>
                        Hesap İşlemleri Özellikleri
                    </h3>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-shield-alt"></i>
                                </div>
                                <div>
                                    <h5>Güvenli İşlemler</h5>
                                    <p class="text-muted mb-0">Tüm işlemleriniz 256-bit SSL şifreleme ile korunmaktadır.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-clock"></i>
                                </div>
                                <div>
                                    <h5>7/24 Erişim</h5>
                                    <p class="text-muted mb-0">Hesap işlemlerinize istediğiniz zaman erişebilirsiniz.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-mobile-alt"></i>
                                </div>
                                <div>
                                    <h5>Mobil Uyumlu</h5>
                                    <p class="text-muted mb-0">Tüm cihazlardan sorunsuz erişim sağlayın.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-bell"></i>
                                </div>
                                <div>
                                    <h5>Anlık Bildirimler</h5>
                                    <p class="text-muted mb-0">Her işlem için anında bildirim alın.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .service-detail-container {
        padding: 2rem 0;
    }

    .page-header {
        padding-left: 3rem;
        padding-right: 3rem;
    }

    .service-header-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, var(--secondary-color) 0%, var(--accent-color) 100%);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: var(--shadow-md);
    }

    .feature-card {
        transition: all 0.3s ease;
        border-radius: 16px;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg) !important;
    }

    .feature-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, var(--secondary-color) 0%, var(--accent-color) 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .feature-badge {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, var(--secondary-color) 0%, var(--accent-color) 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
        flex-shrink: 0;
    }
</style>

