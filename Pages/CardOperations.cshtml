@page "/CardOperations"
@model figjam2.Pages.CardOperationsModel
@{
    ViewData["Title"] = "Kart İşlemleri";
}

<div class="profile_container">
    <div class="page_header mb-4 fade-in">
        <h1>
            <i class="fas fa-id-card me-2 text-secondary-custom"></i>
            Kart İşlemleri
        </h1>
        <p class="text-muted">Kredi kartı, banka kartı işlemleri ve kart limitlerinizi yönetin</p>
    </div>

    <div class="row g-4">
        <!-- Kredi Kartı -->
        <div class="col-12 col-md-6 col-lg-4 fade-in">
            <div class="card h-100 feature-card" style="border: 2px solid #E6F7FF; border-radius: 16px;">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-credit-card"></i>
                    </div>
                    <h4 class="mb-3" style="color: #2E6DF8;">Kredi Kartı</h4>
                    <p class="text-muted mb-4 flex-grow-1">Kredi kartı işlemlerinizi yönetin ve limitlerinizi kontrol edin.</p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Kart limiti sorgulama</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Ekstre görüntüleme</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Ödeme planı oluşturma</li>
                    </ul>
                    <a href="/Dashboard" class="btn btn-primary w-100" style="background-color: #2E6DF8; border: none; border-radius: 12px; padding: 0.75rem;">
                        <i class="fas fa-credit-card me-2"></i>Kart Detayları
                    </a>
                </div>
            </div>
        </div>

        <!-- Banka Kartı -->
        <div class="col-12 col-md-6 col-lg-4 fade-in">
            <div class="card h-100 feature-card" style="border: 2px solid #E6F7FF; border-radius: 16px;">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-money-check-alt"></i>
                    </div>
                    <h4 class="mb-3" style="color: #2E6DF8;">Banka Kartı</h4>
                    <p class="text-muted mb-4 flex-grow-1">Banka kartı işlemlerinizi takip edin ve güvenlik ayarlarını yapın.</p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Kart bloke/kaldır</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>İşlem geçmişi</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Güvenlik ayarları</li>
                    </ul>
                    <a href="/Dashboard" class="btn btn-primary w-100" style="background-color: #2E6DF8; border: none; border-radius: 12px; padding: 0.75rem;">
                        <i class="fas fa-cog me-2"></i>Kart Ayarları
                    </a>
                </div>
            </div>
        </div>

        <!-- Sanal Kart -->
        <div class="col-12 col-md-6 col-lg-4 fade-in">
            <div class="card h-100 feature-card" style="border: 2px solid #E6F7FF; border-radius: 16px;">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <h4 class="mb-3" style="color: #2E6DF8;">Sanal Kart</h4>
                    <p class="text-muted mb-4 flex-grow-1">Online alışverişleriniz için güvenli sanal kart oluşturun.</p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Anında kart oluşturma</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Limit belirleme</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Otomatik iptal</li>
                    </ul>
                    <a href="/Dashboard" class="btn btn-primary w-100" style="background-color: #2E6DF8; border: none; border-radius: 12px; padding: 0.75rem;">
                        <i class="fas fa-plus-circle me-2"></i>Sanal Kart Oluştur
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Kart Özellikleri -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-body p-5">
                    <h3 class="mb-4 text-center">
                        <i class="fas fa-shield-alt me-2 text-secondary-custom"></i>
                        Kart Güvenliği ve Özellikleri
                    </h3>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-lock"></i>
                                </div>
                                <div>
                                    <h5>3D Secure</h5>
                                    <p class="text-muted mb-0">Tüm online işlemleriniz 3D Secure ile korunur.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-bell"></i>
                                </div>
                                <div>
                                    <h5>Anlık Bildirimler</h5>
                                    <p class="text-muted mb-0">Her işlem için SMS ve e-posta bildirimi alın.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-globe"></i>
                                </div>
                                <div>
                                    <h5>Yurt Dışı Kullanım</h5>
                                    <p class="text-muted mb-0">Kartınızı yurt dışında da güvenle kullanın.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-headset"></i>
                                </div>
                                <div>
                                    <h5>7/24 Destek</h5>
                                    <p class="text-muted mb-0">Kart işlemleriniz için her zaman destek alın.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .profile_container {
        padding: 2rem 0;
        margin: -1cm 5cm 0 5cm;
    }

    .page_header {
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 1rem;
        margin-top: 1cm;
    }

    .feature-card {
        transition: all 0.3s ease;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(46, 109, 248, 0.1);
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(46, 109, 248, 0.15) !important;
    }

    .feature-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, var(--secondary-color) 0%, var(--accent-color) 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .feature-badge {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, var(--secondary-color) 0%, var(--accent-color) 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    /* Responsive düzenlemeler */
    @@media (max-width: 992px) {
        .profile_container {
            margin: -1cm 2cm 0 2cm;
        }
    }

    @@media (max-width: 768px) {
        .profile_container {
            margin: -1cm 1cm 0 1cm;
        }
    }
</style>

