@page "/DigitalBanking"
@model figjam2.Pages.DigitalBankingModel
@{
    ViewData["Title"] = "Dijital Bankacılık";
}

<div class="profile_container">
    <div class="page_header mb-4 fade-in">
        <h1>
            <i class="fas fa-mobile-alt me-2 text-secondary-custom"></i>
            Dijital Bankacılık
        </h1>
        <p class="text-muted">Mobil uygulama, SMS bankacılık ve dijital cüzdan hizmetleri ile bankacılık işlemlerinizi kolaylaştırın</p>
    </div>

    <div class="row g-4">
        <!-- Mobil Uygulama -->
        <div class="col-12 col-lg-4 fade-in">
            <div class="card h-100 feature-card">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <h4 class="mb-3">Mobil Uygulama</h4>
                    <p class="text-muted mb-4">iOS ve Android için geliştirilmiş mobil bankacılık uygulaması.</p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Hızlı ve güvenli</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Parmak izi/Face ID</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Tüm işlemler</li>
                    </ul>
                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-primary flex-fill">
                            <i class="fab fa-apple me-2"></i>App Store
                        </a>
                        <a href="#" class="btn btn-primary flex-fill">
                            <i class="fab fa-google-play me-2"></i>Play Store
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- SMS Bankacılık -->
        <div class="col-12 col-lg-4 fade-in">
            <div class="card h-100 feature-card">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-sms"></i>
                    </div>
                    <h4 class="mb-3">SMS Bankacılık</h4>
                    <p class="text-muted mb-4">Cep telefonunuzdan SMS ile bankacılık işlemlerinizi yapın.</p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Bakiye sorgulama</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Havale/EFT</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Fatura ödeme</li>
                    </ul>
                    <a href="/Dashboard" class="btn btn-primary w-100">
                        <i class="fas fa-phone me-2"></i>Aktif Et
                    </a>
                </div>
            </div>
        </div>

        <!-- Dijital Cüzdan -->
        <div class="col-12 col-lg-4 fade-in">
            <div class="card h-100 feature-card">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-wallet"></i>
                    </div>
                    <h4 class="mb-3">Dijital Cüzdan</h4>
                    <p class="text-muted mb-4">Apple Pay, Google Pay ve diğer dijital cüzdan entegrasyonları.</p>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Hızlı ödeme</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Güvenli işlem</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Kolay kullanım</li>
                    </ul>
                    <a href="/Dashboard" class="btn btn-primary w-100">
                        <i class="fas fa-link me-2"></i>Bağla
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Dijital Bankacılık Avantajları -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-body p-5">
                    <h3 class="mb-4 text-center">
                        <i class="fas fa-rocket me-2 text-secondary-custom"></i>
                        Dijital Bankacılık Avantajları
                    </h3>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-clock"></i>
                                </div>
                                <div>
                                    <h5>7/24 Erişim</h5>
                                    <p class="text-muted mb-0">İstediğiniz zaman, istediğiniz yerden bankacılık işlemlerinizi yapın.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-shield-alt"></i>
                                </div>
                                <div>
                                    <h5>Güvenli Platform</h5>
                                    <p class="text-muted mb-0">256-bit SSL şifreleme ile tüm işlemleriniz korunur.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-bolt"></i>
                                </div>
                                <div>
                                    <h5>Hızlı İşlemler</h5>
                                    <p class="text-muted mb-0">Saniyeler içinde işlemlerinizi tamamlayın.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-4">
                                <div class="feature-badge me-3">
                                    <i class="fas fa-user-shield"></i>
                                </div>
                                <div>
                                    <h5>Biyometrik Güvenlik</h5>
                                    <p class="text-muted mb-0">Parmak izi ve yüz tanıma ile güvenli giriş.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .profile_container {
        padding: 2rem 0;
        margin: -1cm 5cm 0 5cm;
    }

    .page_header {
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 1rem;
        margin-top: 1cm;
    }

    .feature-card {
        transition: all 0.3s ease;
        border-radius: 16px;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg) !important;
    }

    .feature-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, var(--secondary-color) 0%, var(--accent-color) 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .feature-badge {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, var(--secondary-color) 0%, var(--accent-color) 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
        flex-shrink: 0;
    }
</style>

